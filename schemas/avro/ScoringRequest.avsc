{
  "type": "record",
  "name": "ScoringRequest",
  "namespace": "cm.imf.pipeline.events",
  "doc": "Demande de scoring MCRS envoyée au service FastAPI ML via Kafka.",
  "fields": [
    {"name": "request_id",             "type": "string", "doc": "UUID de la demande (corrélation réponse)"},
    {"name": "client_id_externe",      "type": "string"},
    {"name": "imf_id",                 "type": "int"},
    {"name": "region_id",              "type": "string"},
    {"name": "regularite_collecte_pct","type": "double", "default": 0.0},
    {"name": "nb_collectes_30j",       "type": "double", "default": 0.0},
    {"name": "montant_moyen_collecte", "type": "double", "default": 0.0},
    {"name": "tendance_collecte_30j",  "type": "double", "default": 0.0},
    {"name": "coefficient_variation_collecte", "type": "double", "default": 0.0},
    {"name": "nb_semaines_sans_collecte",      "type": "double", "default": 0.0},
    {"name": "rang_collecte_agence",   "type": "double", "default": 0.5},
    {"name": "jours_retard_actuel",    "type": "double", "default": 0.0},
    {"name": "nb_incidents_paiement_12m", "type": "double", "default": 0.0},
    {"name": "taux_remboursement_historique", "type": "double", "default": 0.5},
    {"name": "ratio_creance_revenus",  "type": "double", "default": 0.0},
    {"name": "nb_reechelonnements",    "type": "double", "default": 0.0},
    {"name": "score_rps_precedent",    "type": "double", "default": 0.5},
    {"name": "prix_moyen_30j",         "type": "double", "default": 0.0},
    {"name": "volatilite_prix_30j",    "type": "double", "default": 0.0},
    {"name": "saisonnalite_prix",      "type": "double", "default": 0.0},
    {"name": "precipitations_30j",     "type": "double", "default": 0.0},
    {"name": "indice_secheresse",      "type": "double", "default": 0.0},
    {"name": "inflation",              "type": "double", "default": 3.0},
    {"name": "taux_beac",              "type": "double", "default": 4.5},
    {"name": "ipc",                    "type": "double", "default": 100.0},
    {"name": "chomage",                "type": "double", "default": 3.5},
    {"name": "indice_resilience",      "type": "double", "default": 0.5},
    {"name": "capacite_remboursement", "type": "double", "default": 1.0},
    {"name": "ratio_collecte_credit",  "type": "double", "default": 0.0},
    {"name": "score_diversification_produits", "type": "double", "default": 0.5},
    {"name": "risque_regional",        "type": "double", "default": 1.12},
    {"name": "taux_penetration_mobile","type": "double", "default": 0.5},
    {"name": "zone_agroclimatique",    "type": "double", "default": 1.0},
    {"name": "saison_recolte_active",  "type": "double", "default": 0.0},
    {"name": "timestamp_ms",           "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
