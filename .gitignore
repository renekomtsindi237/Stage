# ══════════════════════════════════════════
# MicroRecouv — .gitignore monorepo
# ══════════════════════════════════════════

# ── Rapport de stage (contenu académique privé) ───
rapport/

# ── Secrets & Env ─────────────────────────
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
firebase-credentials.json
*-credentials.json
*.bak

# ── VPS / Déploiement ─────────────────────
vps_connect.sh
vps_sync/
deploy/secrets/
*.staging.bak

# ── Docker ────────────────────────────────
docker/volumes/

# ── Backend (Spring Boot / Maven) ─────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
src/backend/target/
!backend/.mvn/wrapper/maven-wrapper.properties

# ── Web (Angular / Node) ──────────────────
web/node_modules/
web/dist/
web/.angular/cache/
src/web/node_modules/
src/web/dist/

# ── Frontend Angular (nouveau) ────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/

# ── Python venv ───────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── Pipeline (Python) ─────────────────────
pipeline/src/__pycache__/
pipeline/src/*.pyc
pipeline/src/.env
pipeline/src/.venv/
pipeline/logs/
pipeline/data/
src/pipeline/__pycache__/
src/pipeline/*.pyc

# ── Mobile (Flutter) ──────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/coverage/
mobile/pubspec.lock
mobile/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# ── dbt ───────────────────────────────────
pipeline/dbt_project/target/
pipeline/dbt_project/dbt_packages/
pipeline/dbt_project/logs/

# ── IDE ───────────────────────────────────
.idea/
.vscode/settings.json
*.iml
*.iws

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────
*.log
logs/

# ── Data / Warehouse (fichiers volumineux — hors Git) ─────────────────────
data/
*.csv
*.parquet
*.arrow
*.json.gz

# ── Screens (design mockups à la racine uniquement)
/screens/

# ── ML modèles entraînés ──────────────────
pipeline/models/
ml/models/
*.pkl
*.joblib
*.h5
*.onnx

# ── Airflow ───────────────────────────────
pipeline/dags/__pycache__/
airflow.cfg
standalone_admin_password.txt
