# ══════════════════════════════════════════
# MicroRecouv — .gitignore monorepo
# ══════════════════════════════════════════

# ── Rapport de stage (contenu académique privé) ───
rapport/

# ── Documentation de conception détaillée (usage personnel) ───
doc-conception-perso/

# ── Proposition pour un projet distinct (Lakehouse microfinance) ───
proposition-lakehouse/

# ── Secrets & Env ─────────────────────────
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
firebase-credentials.json
*-credentials.json
*.bak

# ── VPS / Déploiement ─────────────────────
vps_connect.sh
vps_sync/
deploy/secrets/
*.staging.bak

# ── Docker ────────────────────────────────
docker/volumes/

# ── Backend (Spring Boot / Maven) ─────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
src/backend/target/
!backend/.mvn/wrapper/maven-wrapper.properties

# ── Web (Angular / Node) ──────────────────
web/node_modules/
web/dist/
web/.angular/cache/
src/web/node_modules/
src/web/dist/

# ── Frontend Angular (nouveau) ────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/

# ── Desktop (Tauri) ───────────────────────
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/dist/

# ── Python venv ───────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── Pipeline (Python) ─────────────────────
pipeline/src/__pycache__/
pipeline/src/*.pyc
pipeline/src/.env
pipeline/src/.venv/
pipeline/logs/
pipeline/data/
src/pipeline/__pycache__/
src/pipeline/*.pyc

# ── Mobile (Flutter) ──────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/coverage/
mobile/dist/
mobile/pubspec.lock
mobile/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# ── dbt ───────────────────────────────────
pipeline/dbt_project/target/
pipeline/dbt_project/dbt_packages/
pipeline/dbt_project/logs/

# ── IDE ───────────────────────────────────
.idea/
.vscode/settings.json
*.iml
*.iws

# ── OS ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────
*.log
logs/

# ── Data / Warehouse (fichiers volumineux — hors Git) ─────────────────────
data/
*.csv
*.parquet
*.arrow
*.json.gz

# Exception : index RAG précalculé (petit artefact, nécessaire au runtime
# ml-api — pipeline/src/rag/ingestion.py régénère ce fichier depuis la doc)
!pipeline/src/rag/data/

# ── Screens (design mockups à la racine uniquement)
/screens/

# ── ML modèles entraînés ──────────────────
pipeline/models/
ml/models/
*.pkl
*.joblib
*.h5
*.onnx
# Exceptions : artefacts de résultats lisibles (graphiques, rapports, features)
!pipeline/models/fintech/*.png
!pipeline/models/fintech/*.json
!pipeline/models/fintech/features_fintech.csv

# Exception : modèle MCRS "champion" promu en production (backup VPS staging, 2026-07-16)
!pipeline/models/mcrs/champion/*.pkl
!pipeline/models/mcrs/champion/*.npy
!pipeline/models/mcrs/champion/*.json

# Exception : index RAG précalculé (petit artefact TF-IDF, nécessaire au
# runtime ml-api — pipeline/src/rag/ingestion.py le régénère depuis la doc)
!pipeline/src/rag/data/*.pkl

# ── Airflow ───────────────────────────────
pipeline/dags/__pycache__/
airflow.cfg
standalone_admin_password.txt

#Documentation
api_docs/