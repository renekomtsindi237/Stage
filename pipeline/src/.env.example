# ============================================================
# .env.example — Variables d'environnement du pipeline ETL IMF
# Copier en .env et adapter selon l'environnement
# ============================================================

# Base de données PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=imf_db
POSTGRES_USER=imf_user
POSTGRES_PASSWORD=changeme_secure_password

# Schémas PostgreSQL
STAGING_SCHEMA=staging
DW_SCHEMA=dw
APP_SCHEMA=app

# API Spring Boot (interne)
SPRING_BASE_URL=http://localhost:8080
SPRING_API_KEY=changeme_internal_api_key

# Timeouts API (secondes)
API_CONNECT_TIMEOUT=5
API_READ_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_WAIT_SECONDS=2.0

# Paramètres métier
PAR30_DAYS=30
PAR90_DAYS=90
ALERTE_MIN_JOURS_RETARD=30
PIPELINE_BATCH_SIZE=500

# Environnement : dev | staging | prod
APP_ENV=dev
