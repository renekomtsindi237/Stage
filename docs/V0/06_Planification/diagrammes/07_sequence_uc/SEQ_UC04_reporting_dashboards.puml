@startuml SEQ_UC04_reporting_dashboards
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceGroupBorderColor #9E9E9E
skinparam sequenceBoxBackgroundColor #EEF4FF
skinparam sequenceBoxBorderColor #4A6CF7
skinparam sequenceParticipantBackgroundColor #EEF4FF
skinparam sequenceParticipantBorderColor #4A6CF7
skinparam sequenceActorBackgroundColor #FFF3E0
skinparam sequenceActorBorderColor #E65100
skinparam sequenceLifeLineBorderColor #9E9E9E
skinparam noteBorderColor #F57F17
skinparam noteBackgroundColor #FFFDE7
skinparam Padding 8

title SEQ_UC04 — Reporting & Tableaux de Bord (Angular)\nDonnées multi-sources agrégées → Spring Boot → Angular SPA\n<size:11><color:#555>Architecture conteneurisée Docker — Données issues de CBS + MTN + Orange + Agents</color></size>

' ===== ACTEURS =====
actor "Directeur Général\n(Web Angular)" as DG
actor "Responsable\nRecouvrement\n(Web Angular)" as RR
actor "Analyste Data\n(Web Angular)" as AD

' ===== CONTENEUR : nginx =====
box "🐳 nginx (:80/:443)\n[Reverse Proxy + Serveur Angular]" #FFF9C4
  participant "Nginx\n[Sert index.html Angular\nProxy /api/* → springboot:8080]" as NGINX
end box

' ===== CONTENEUR : angular (logique côté client) =====
box "📦 Angular SPA (navigateur client)" #E3F2FD
  participant "Angular Router\n[AuthGuard + RoleGuard]" as ROUTER
  participant "KpiService\n[Angular HttpClient]" as ANG_SVC
  participant "AuthInterceptor\n[Injecte JWT Bearer]" as INTER
  participant "Chart.js Components\n[line, bar, pie]" as CHART
  participant "Angular Material\n[Table, Filters, Cards]" as MAT
end box

' ===== CONTENEUR : springboot =====
box "🐳 springboot-api (:8080 interne)" #E8F5E9
  participant "KpiController\n[@RestController\n@RequestMapping('/api/kpi')]" as CTRL
  participant "KpiService\n[@Service]" as SVC
  participant "AlerteRepository\n[count actives]" as REPO_ALE
  participant "KpiParRepository\n[lecture DW/reporting]" as REPO_PAR
  participant "CollecteRepository\n[lecture DW/reporting]" as REPO_COL
end box

' ===== CONTENEUR : postgres-pipeline =====
box "🐳 postgres-pipeline (:5432)" #E8F5E9
  database "reporting\nv_kpi_collectes\nv_kpi_recouvrement\nv_kpi_executif\n<i>(vues matérialisées\npré-agrégées — toutes sources)</i>" as RPT
  database "staging\nalertes_impayes" as STG
end box

note over RPT : Les vues matérialisées agrègent\nautomatiquement les données de :\n• CBS (prêts, remboursements)\n• MTN Mobile Money (transactions)\n• Orange Money (transactions)\n• Agents terrain (collectes)\n→ 1 seule source de vérité

' =================================================
' ÉTAPE 1 — CHARGEMENT INITIAL APP ANGULAR
' =================================================
== 🌐 ÉTAPE 1 — Chargement de l'application Angular ==

DG -> NGINX : HTTPS GET https://imf-plateforme.cm/
NGINX -> DG : HTTP 200\nContent: dist/angular/index.html\n+ main.js, polyfills.js, styles.css\n(fichiers Angular compilés dans volume /angular-dist/)

DG -> ROUTER : Bootstrap Angular\nÉvaluation des routes
ROUTER -> ROUTER : AuthGuard.canActivate()\nVérifie JWT dans sessionStorage

alt <b>JWT valide et non expiré</b>
  ROUTER -> DG : Redirige vers /dashboard-executif (Directeur)
else <b>Pas de JWT ou expiré</b>
  ROUTER -> DG : Redirige vers /login
end

' =================================================
' ÉTAPE 2 — DASHBOARD EXÉCUTIF (Directeur)
' =================================================
== 📊 ÉTAPE 2 — Dashboard Exécutif (Directeur) | Données : CBS + MTN + Orange + Agents ==

DG -> ANG_SVC : ngOnInit() → loadDashboardExecutif()
ANG_SVC -> INTER : http.get('/api/kpi/dashboard-summary')
INTER -> INTER : Lit JWT depuis sessionStorage\nAjoute header Authorization: Bearer <JWT>

INTER -> NGINX : HTTPS GET /api/kpi/dashboard-summary
NGINX -> CTRL : HTTP Proxy → springboot:8080\nGET /api/kpi/dashboard-summary

CTRL -> CTRL : JwtAuthFilter: valide JWT\n@PreAuthorize("hasRole('DIRECTEUR')")

CTRL -> SVC : getDashboardSummary()

' Appels parallèles vers les vues
par
  SVC -> REPO_PAR : findLatestPar()
  REPO_PAR -> RPT : SELECT taux_par30, taux_par90,\nencours_total, nb_prets_actifs\nFROM reporting.v_kpi_recouvrement\nWHERE date_complete = CURRENT_DATE - 1
  RPT --> REPO_PAR : {par30: 0.083, par90: 0.031,\nencours: 625_000_000 XAF}
  note right RPT : Données CBS\n(prêts + remboursements)

  SVC -> REPO_COL : findTotalCollectes(periode='MOIS_EN_COURS')
  REPO_COL -> RPT : SELECT SUM(montant_total) AS total_mois,\nSUM(nb_mobile_money) AS mobile_mois,\nCOUNT(DISTINCT date_complete) AS nb_jours\nFROM reporting.v_kpi_collectes\nWHERE date_complete >= DATE_TRUNC('month', CURRENT_DATE)
  RPT --> REPO_COL : {total: 87_300_000 XAF,\n pct_mobile: 0.68}
  note right RPT : Données MTN + Orange\n+ Agents terrain

  SVC -> REPO_ALE : countByStatutAlerte('ACTIVE')
  REPO_ALE -> STG : SELECT COUNT(*) FROM staging.alertes_impayes\nWHERE statut_alerte = 'ACTIVE'
  STG --> REPO_ALE : 47 alertes actives

  SVC -> REPO_PAR : findPar30Trend(30)
  REPO_PAR -> RPT : SELECT date_complete, taux_par30\nFROM reporting.v_kpi_recouvrement\nWHERE date_complete >= CURRENT_DATE - 30\nORDER BY date_complete ASC
  RPT --> REPO_PAR : [{date, par30} × 30 jours]
end

SVC -> SVC : build DashboardSummaryResponse {\n  par30: 0.083, par90: 0.031,\n  totalCollectes: 87_300_000,\n  tauxMobileMoney: 0.68,\n  nbAlertes: 47,\n  nbPretsActifs: 1250,\n  trendPar30: [×30]\n}
SVC --> CTRL : DashboardSummaryResponse
CTRL --> NGINX : HTTP 200 JSON (gzip)
NGINX --> ANG_SVC : HTTPS 200 JSON

ANG_SVC -> CHART : Injecte données dans\nLineChart (PAR30 tendance)\nBarChart (collectes par canal)\nKpiCards (PAR30/90, alertes)
ANG_SVC -> MAT : Peuple MatTable\n(alertes actives top 5)
CHART --> DG : Dashboard Exécutif rendu
MAT --> DG : Tableau alertes affiché

' =================================================
' ÉTAPE 3 — FILTRAGE DYNAMIQUE (Responsable Recouvrement)
' =================================================
== 🔍 ÉTAPE 3 — Dashboard Recouvrement avec filtres dynamiques (RR) ==

RR -> NGINX : HTTPS GET /api/kpi/par\n?dateDebut=2026-01-01&dateFin=2026-04-01\n&zoneId=2&produitId=3\nAuthorization: Bearer <JWT_RR>
NGINX -> CTRL : Proxy
CTRL -> CTRL : @PreAuthorize("hasAnyRole\n('RESPONSABLE_RECOUVREMENT','DIRECTEUR','ANALYSTE')")
CTRL -> SVC : getParStats(dateDebut, dateFin, zoneId=2, produitId=3)
SVC -> REPO_PAR : findParByFilters(params)
REPO_PAR -> RPT : SELECT date_complete, nom_zone,\nnom_produit, taux_par30, taux_par90,\nencours_par30, encours_par90,\nnb_prets_en_retard\nFROM reporting.v_kpi_recouvrement\nWHERE date_complete BETWEEN '2026-01-01' AND '2026-04-01'\nAND zone_id = 2 AND produit_id = 3\nORDER BY date_complete ASC

RPT --> REPO_PAR : 90 lignes (filtres appliqués)
REPO_PAR --> SVC : KpiParResponse (filtré)
SVC --> NGINX : HTTP 200 JSON
NGINX --> RR : Données filtrées → Angular met à jour les graphiques\n(RxJS debounceTime 300ms évite les appels excessifs)

' =================================================
' ÉTAPE 4 — EXPORT CSV (Analyste)
' =================================================
== 📥 ÉTAPE 4 — Export CSV depuis le Dashboard (Analyste) ==

AD -> NGINX : HTTPS GET /api/kpi/collectes/export\n?format=csv&dateDebut=2026-01-01&dateFin=2026-04-01\nAuthorization: Bearer <JWT_ANALYSTE>
NGINX -> CTRL : Proxy GET /api/kpi/collectes/export
CTRL -> CTRL : @PreAuthorize("hasAnyRole('ANALYSTE','DIRECTEUR')")
CTRL -> SVC : exportCollectesCSV(params)
SVC -> REPO_COL : findAllCollectesByPeriod(params)
REPO_COL -> RPT : SELECT date_complete, nom_zone, nom_canal,\nnom_agent, nb_collectes, montant_total,\nmontant_moyen, nb_mobile_money\nFROM reporting.v_kpi_collectes\nWHERE date_complete BETWEEN ? AND ?\nORDER BY date_complete, nom_zone
RPT --> REPO_COL : N lignes toutes sources confondues
REPO_COL --> SVC : List<KpiCollecteRow>
SVC -> SVC : generateCSV(rows)\n→ RFC 4180 : "Date,Zone,Canal,Nb collectes,Montant..."
SVC --> CTRL : byte[] (CSV content)
CTRL --> NGINX : HTTP 200\nContent-Type: text/csv\nContent-Disposition: attachment; filename="collectes_2026-Q1.csv"
NGINX --> AD : Téléchargement CSV (navigateur)\nDonnées : MTN + Orange + Agents — toutes sources

@enduml
