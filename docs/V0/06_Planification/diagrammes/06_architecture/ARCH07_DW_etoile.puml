@startuml ARCH07_DW_Etoile
title ARCH07 — Schéma en Étoile — Data Warehouse (schéma dw)\nPlateforme Pipeline IMF Cameroun

skinparam linetype ortho
skinparam backgroundColor #FAFAFA
skinparam entity {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
  HeaderBackgroundColor #4A148C
  HeaderFontColor white
}
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
}

' ══════════════════════════════════════════════
' DIMENSIONS
' ══════════════════════════════════════════════

entity "dw.dim_date" as DIM_DATE {
  <u>date_key</u> : INTEGER PK
  ' Format YYYYMMDD (ex: 20260401)
  ==
  date_valeur : DATE UNIQUE NOT NULL
  annee : INTEGER NOT NULL
  trimestre : INTEGER NOT NULL
  mois : INTEGER NOT NULL
  semaine : INTEGER NOT NULL
  jour_mois : INTEGER NOT NULL
  jour_semaine : INTEGER NOT NULL
  nom_jour : VARCHAR(20)
  nom_mois : VARCHAR(20)
  est_weekend : BOOLEAN
  est_jour_ferie : BOOLEAN
  ' (jours fériés Cameroun inclus)
}

entity "dw.dim_client" as DIM_CLIENT {
  <u>id_client_source</u> : VARCHAR(30) PK
  ==
  nom_client : VARCHAR(200) NOT NULL
  telephone : VARCHAR(20)
  zone_geographique : VARCHAR(100)
  date_premiere_op : DATE
  _dbt_updated_at : TIMESTAMP
}

entity "dw.dim_agence" as DIM_AGENCE {
  <u>id_agence</u> : VARCHAR(32) PK
  ' MD5(nom_agence normalisé)
  ==
  nom_agence : VARCHAR(100) NOT NULL
  _dbt_updated_at : TIMESTAMP
}

entity "dw.dim_produit" as DIM_PRODUIT {
  <u>id_produit</u> : VARCHAR(32) PK
  ' MD5(nom_produit normalisé)
  ==
  nom_produit : VARCHAR(100) NOT NULL
  _dbt_updated_at : TIMESTAMP
}

entity "dw.dim_agent" as DIM_AGENT {
  <u>id_agent</u> : VARCHAR(32) PK
  ' MD5(nom_agent normalisé)
  ==
  nom_agent : VARCHAR(100) NOT NULL
  id_agence : VARCHAR(32)
  nom_agence : VARCHAR(100)
  _dbt_updated_at : TIMESTAMP
}

' ══════════════════════════════════════════════
' TABLES DE FAITS
' ══════════════════════════════════════════════

entity "dw.fact_collectes" as FACT_COLLECTES {
  <u>id_source</u> : VARCHAR(60) PK
  ' Format : MTN-{id}, ORANGE-{id}, TERRAIN-{id}
  ==
  #date_key : INTEGER FK → dim_date
  #id_client_source : VARCHAR(30) FK → dim_client
  #id_agence : VARCHAR(32) FK → dim_agence
  #id_agent : VARCHAR(32) FK → dim_agent
  --
  canal : VARCHAR(20) NOT NULL
  ' CHECK: MTN, ORANGE, TERRAIN_MOBILE, TERRAIN_ESPECES
  montant : NUMERIC(15,2) NOT NULL
  reference_transaction : VARCHAR(100)
  nom_payeur : VARCHAR(200)
  statut : VARCHAR(20)
  nom_fichier_source : VARCHAR(255)
  _dbt_updated_at : TIMESTAMP
}

entity "dw.fact_remboursements" as FACT_REMB {
  <u>id_pret</u> : VARCHAR(30) PK
  ' Granularité : snapshot quotidien par prêt (1 ligne = dernier état)
  ==
  #date_key : INTEGER FK → dim_date
  ' date du snapshot CBS
  #id_client_source : VARCHAR(30) FK → dim_client
  #id_agence : VARCHAR(32) FK → dim_agence
  #id_produit : VARCHAR(32) FK → dim_produit
  #id_agent : VARCHAR(32) FK → dim_agent
  --
  montant_pret : NUMERIC(15,2)
  date_deblocage : DATE
  date_echeance : DATE
  montant_rembourse : NUMERIC(15,2)
  solde_restant : NUMERIC(15,2)
  statut_pret : VARCHAR(20)
  ' CHECK: ACTIF, EN_RETARD, EN_RECOUVREMENT, SOLDE, PERTE
  jours_retard : INTEGER
  _dbt_updated_at : TIMESTAMP
}

' ══════════════════════════════════════════════
' TABLE SCORES ML (Phase 5)
' ══════════════════════════════════════════════
entity "dw.scores_transactions" as FACT_SCORES {
  <u>id_pret</u> : VARCHAR(30) PK
  <u>date_scoring</u> : DATE PK
  ==
  score_risque : NUMERIC(4,3) NOT NULL
  ' [0.000 – 1.000]
  niveau_risque : VARCHAR(10)
  ' GENERATED: FAIBLE / MOYEN / ÉLEVÉ / CRITIQUE
  version_modele : VARCHAR(20)
  _scored_at : TIMESTAMP DEFAULT NOW()
}

' ══════════════════════════════════════════════
' VUES REPORTING
' ══════════════════════════════════════════════
entity "reporting.v_par_par_zone" as V_PAR {
  date_valeur : DATE
  nom_agence : VARCHAR
  encours_total : NUMERIC
  encours_par30 : NUMERIC
  encours_par90 : NUMERIC
  taux_par30 : NUMERIC
  taux_par90 : NUMERIC
  nb_prets_actifs : BIGINT
  nb_prets_en_retard : BIGINT
}

entity "reporting.v_collectes_par_agent" as V_COLLECTES {
  date_valeur : DATE
  nom_agence : VARCHAR
  nom_agent : VARCHAR
  canal : VARCHAR
  nb_collectes : BIGINT
  montant_total : NUMERIC
}

' ══════════════════════════════════════════════
' RELATIONS FAITS → DIMENSIONS
' ══════════════════════════════════════════════
DIM_DATE    ||--o{ FACT_COLLECTES : "date_key (N,1)"
DIM_CLIENT  ||--o{ FACT_COLLECTES : "id_client_source (N,1)"
DIM_AGENCE  ||--o{ FACT_COLLECTES : "id_agence (N,1)"
DIM_AGENT   ||--o{ FACT_COLLECTES : "id_agent (N,1)"

DIM_DATE    ||--o{ FACT_REMB : "date_key (N,1)"
DIM_CLIENT  ||--o{ FACT_REMB : "id_client_source (N,1)"
DIM_AGENCE  ||--o{ FACT_REMB : "id_agence (N,1)"
DIM_PRODUIT ||--o{ FACT_REMB : "id_produit (N,1)"
DIM_AGENT   ||--o{ FACT_REMB : "id_agent (N,1)"

DIM_AGENCE  ||--o{ DIM_AGENT : "id_agence"

FACT_REMB ||--o{ FACT_SCORES : "id_pret (1,N)"

' Vues issues des faits
FACT_REMB ..> V_PAR : alimente
FACT_COLLECTES ..> V_COLLECTES : alimente

note bottom of FACT_COLLECTES
  Granularité : 1 ligne = 1 collecte
  (MTN, Orange, ou terrain mobile)
  Stratégie : INCREMENTAL dbt
  Clé unique : id_source (canal-id)
end note

note bottom of FACT_REMB
  Granularité : 1 ligne = snapshot quotidien
  par prêt (dernier état CBS du jour)
  Stratégie : INCREMENTAL dbt
  Clé unique : id_pret
end note

note right of FACT_SCORES
  Alimentée par le DAG ML (Phase 5)
  Clé composite (id_pret, date_scoring)
  Permet de suivre l'évolution du score
  dans le temps pour chaque prêt
end note

@enduml
