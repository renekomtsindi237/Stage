@startuml ETT03_cycle_collecte_mobile
!theme plain
skinparam backgroundColor #FAFAFA
skinparam state {
  BackgroundColor #E8EAF6
  BorderColor #3949AB
  FontSize 12
  ArrowColor #555555
  ArrowThickness 1.5
}

title ETT03 — Cycle de Vie d'une Collecte Mobile (Flutter)\nGestion Offline-First + Synchronisation

[*] --> DRAFT : Agent ouvre le formulaire\n(SaisieCollecteScreen)

DRAFT : Saisie en cours\nFormulaire non soumis
DRAFT : --
DRAFT : do / Saisie montant, client, canal

DRAFT --> ABANDONED : Agent ferme\nsans soumettre

DRAFT --> VALIDATING : Agent soumet\n(bouton "Enregistrer")

ABANDONED --> [*]

state VALIDATING {
  [*] --> form_check
  form_check : Validation Dart côté client\n(montant > 0, client sélectionné)
}

VALIDATING : Validation en cours
VALIDATING --> DRAFT : Erreur validation\n(champ manquant / montant invalide)
VALIDATING --> SENDING : Validation OK\nConnexion disponible
VALIDATING --> PENDING_SYNC : Validation OK\nHors ligne

state SENDING {
  [*] --> http_post
  http_post : POST /api/collectes\n(Spring Boot API)
}

SENDING : Envoi en cours (online)
SENDING : --
SENDING : do / POST /api/collectes avec JWT

SENDING --> CONFIRMED : 201 Created\n(serveur accepte)
SENDING --> DUPLICATE : 409 Conflict\n(doublon détecté)
SENDING --> PENDING_SYNC : Erreur réseau / timeout\n(DioException)

state CONFIRMED {
  CONFIRMED : id_collecte assigné\n(ex: COL-2026-789)
}

CONFIRMED : Collecte confirmée par le serveur\nstatut = CONFIRMED (DB + SQLite local)
CONFIRMED : --
CONFIRMED : entry / Sauvegarde SQLite (historique)
CONFIRMED : entry / Affiche toast "✓ Collecte enregistrée"
CONFIRMED : entry / Refresh historique agent

CONFIRMED --> [*]

state DUPLICATE {
  DUPLICATE : Collecte déjà enregistrée\n(même ref + jour)
}

DUPLICATE : Doublon détecté
DUPLICATE : --
DUPLICATE : entry / Affiche message erreur
DUPLICATE : entry / Log local (statut=DUPLICATE)

DUPLICATE --> [*]

state PENDING_SYNC {
  [*] --> local_saved
  local_saved : INSERT SQLite\nstatut = PENDING_SYNC
  local_saved --> waiting_connectivity
  waiting_connectivity : En attente reconnexion
}

PENDING_SYNC : Sauvegardée localement\nen attente de synchronisation
PENDING_SYNC : --
PENDING_SYNC : entry / INSERT SQLite (offline)
PENDING_SYNC : entry / Affiche badge "hors ligne"
PENDING_SYNC : do / SyncService écoute\nConnectivityPlus

PENDING_SYNC --> SYNCING : Retour connectivité détecté\n(ConnectivityPlus)

state SYNCING {
  [*] --> retry_post
  retry_post : POST /api/collectes (retry)
}

SYNCING : Synchronisation en cours
SYNCING --> CONFIRMED : 201 Created\n(sync réussie)
SYNCING --> DUPLICATE : 409 Conflict\n(doublon post-sync)
SYNCING --> SYNC_ERROR : 5xx / Timeout\n(retry_count < 3)

state SYNC_ERROR {
  SYNC_ERROR : Erreur de synchronisation\nretry_count incrémenté
}

SYNC_ERROR : Erreur de sync (retry possible)
SYNC_ERROR : --
SYNC_ERROR : entry / Notification "Échec sync"
SYNC_ERROR : do / Retry automatique (3 max)

SYNC_ERROR --> SYNCING : retry_count++ / retry_count < 3\n(délai exponentiel)
SYNC_ERROR --> FAILED : retry_count >= 3\n(échec définitif)

state FAILED {
  FAILED : Intervention manuelle requise
}

FAILED : Synchronisation définitivement échouée
FAILED : --
FAILED : entry / Alerte utilisateur
FAILED : entry / Log pour DSI

FAILED --> [*]

@enduml
