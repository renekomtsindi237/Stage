@startuml ETT01_cycle_pret
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam state {
  BackgroundColor white
  BorderColor #666666
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ETT01 - Cycle de vie d'un credit\nDossierCredit + ContratCredit + Creance

' -- Phase 1 : Instruction du dossier --

state INSTRUCTION {
  INSTRUCTION : DossierCredit.statut = INSTRUCTION
  INSTRUCTION : entry / Agent de Saisie cree le dossier
  INSTRUCTION : do / Analyste instruit - collecte pieces
}

state EN_COMITE {
  EN_COMITE : DossierCredit.statut = EN_COMITE
  EN_COMITE : do / Deliberation ComiteDecision
}

state APPROUVE {
  APPROUVE : DossierCredit.statut = APPROUVE
  APPROUVE : entry / ContratCredit cree (statut=BROUILLON)
}

state AJOURNE {
  AJOURNE : DossierCredit.statut = AJOURNE
  AJOURNE : do / En attente de complements
}

state REJETE {
  REJETE : DossierCredit.statut = REJETE
}

state CONTRAT_VALIDE {
  CONTRAT_VALIDE : ContratCredit.statut = ACTIF
  CONTRAT_VALIDE : DossierCredit.statut = DEBLOQUE
  CONTRAT_VALIDE : entry / Signatures validees
  CONTRAT_VALIDE : entry / Creance creee (statut=ACTIF)
}

' -- Phase 2 : Cycle de la creance --

state ACTIF {
  ACTIF : Creance.statut = ACTIF
  ACTIF : entry / Echeancier genere
  ACTIF : do / Collectes terrain appliquees
}

state EN_RETARD {
  EN_RETARD : Creance.statut = EN_RETARD
  EN_RETARD : do / AlerteImpaye generee (dag_alertes 08h00)
  EN_RETARD : COBAC B (30-89j, 20%) / C (90-179j, 50%) / D (180-359j, 80%)
}

state EN_RECOUVREMENT {
  EN_RECOUVREMENT : Creance.statut = EN_RECOUVREMENT
  EN_RECOUVREMENT : entry / AlerteImpaye.statut = ESCALADEE
  EN_RECOUVREMENT : do / Plan d'apurement (amiable) ou procedure contentieuse
}

state SOLDE {
  SOLDE : Creance.statut = SOLDE
  SOLDE : entry / AlerteImpaye CLOTUREE
  SOLDE : entry / dag_ml_scoring recalcule MCRS
}

state PERTE {
  PERTE : Creance.statut = PERTE
  PERTE : COBAC classe E - provision 100%
  PERTE : entry / Write-off acte
}

' -- Transitions Phase 1 --

[*]             --> INSTRUCTION
INSTRUCTION     --> EN_COMITE      : Soumission au comite
EN_COMITE       --> APPROUVE       : Approbation comite
EN_COMITE       --> AJOURNE        : Ajournement - pieces manquantes
EN_COMITE       --> REJETE         : Refus comite
AJOURNE         --> INSTRUCTION    : Pieces completees
APPROUVE        --> CONTRAT_VALIDE : Contrat signe et valide
APPROUVE        --> REJETE         : Defaut de signature
REJETE          --> [*]

' -- Transitions Phase 2 --

CONTRAT_VALIDE  --> ACTIF
ACTIF           --> EN_RETARD      : Premier impaye detecte\n(dag_alertes_impayes)
ACTIF           --> SOLDE          : Dernier paiement recu
EN_RETARD       --> ACTIF          : Regularisation integrale
EN_RETARD       --> EN_RECOUVREMENT : joursRetard > 90\nou escalade manuelle Directeur
EN_RECOUVREMENT --> SOLDE          : Recouvrement reussi
EN_RECOUVREMENT --> PERTE          : Irrecouvrabilite constatee\n(jours > 360 - COBAC classe E)
SOLDE           --> [*]
PERTE           --> [*]

note right of EN_RETARD
  Classification COBAC :
  Classe B : 30-89 jours  (provision 20%)
  Classe C : 90-179 jours (provision 50%)
  Classe D : 180-359 jours (provision 80%)
end note

note right of PERTE
  Classe E : >= 360 jours
  Provision 100%
  Creance definitivement irrecouvreable
end note

@enduml
