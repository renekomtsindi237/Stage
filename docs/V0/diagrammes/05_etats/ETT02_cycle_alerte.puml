@startuml ETT02_cycle_alerte
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam state {
  BackgroundColor white
  BorderColor #666666
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ETT02 - Cycle de vie d'une alerte impaye\nStatutAlerte : ACTIVE - ESCALADEE - CLOTUREE

[*] --> ACTIVE : dag_alertes_impayes (08h00 quotidien)\nDetection : Creance.joursRetard > 0\nINSERT AlerteImpaye

state ACTIVE {
  ACTIVE : AlerteImpaye.statutAlerte = ACTIVE
  ACTIVE : entry / Notification SSE envoyee au Directeur
  ACTIVE : entry / Email SMTP si active dans config
  ACTIVE : do / Mise a jour joursRetard quotidienne
}

ACTIVE --> ACTIVE     : 72h sans regularisation\nre-notification Directeur (SSE)
ACTIVE --> CLOTUREE   : Paiement integral recu\n(Creance.statut = SOLDE)
ACTIVE --> CLOTUREE   : Cloture manuelle Directeur\nPUT /api/v1/alertes/{uid}/statut\n{statut: "CLOTUREE"}
ACTIVE --> ESCALADEE  : joursRetard > 90 (PAR90 - COBAC classe C)\nou escalade manuelle Directeur

state ESCALADEE {
  ESCALADEE : AlerteImpaye.statutAlerte = ESCALADEE
  ESCALADEE : entry / Notification SSE prioritaire au Directeur
  ESCALADEE : entry / Planification ComiteDecision
  ESCALADEE : do / Suivi PlanApurement ou ProcedureContentieux
}

ESCALADEE --> CLOTUREE : Recouvrement reussi (amiable ou judiciaire)
ESCALADEE --> CLOTUREE : Write-off acte (Creance.statut = PERTE)\nPUT /api/v1/alertes/{uid}/statut {statut: "CLOTUREE"}

state CLOTUREE {
  CLOTUREE : AlerteImpaye.statutAlerte = CLOTUREE
  CLOTUREE : entry / dateCloture = NOW()
  CLOTUREE : entry / dag_ml_scoring recalcule MCRS client
  CLOTUREE : entry / Archivage schema dw
}

CLOTUREE --> [*]

note right of ACTIVE
  Types d'alertes (typeAlerte) :
  RISQUE_DEFAUT_IMMINENT   (MCRS > 0.75)
  DETERIORATION_RAPIDE     (MCRS > 0.65)
  BAISSE_COLLECTE_PERSISTANTE (MCRS > 0.50)
  ECHEANCE_IMMINENTE
  IMPAYE_CONSTATE
end note

@enduml
