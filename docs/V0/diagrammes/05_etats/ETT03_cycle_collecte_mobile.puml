@startuml ETT03_cycle_collecte_mobile
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam state {
  BackgroundColor white
  BorderColor #666666
  ArrowColor #333333
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ETT03 - Cycle de vie d'une collecte mobile (Flutter)\nGestion Offline-First + Synchronisation

[*] --> DRAFT : Agent ouvre le formulaire\n(CollecteScreen)

DRAFT : entry / Saisie montant, client, canal
DRAFT --> ABANDONED : Agent ferme sans soumettre
DRAFT --> VALIDATING : Agent soumet (bouton Enregistrer)

ABANDONED --> [*]

state VALIDATING {
  [*] --> form_check
  form_check : Validation Dart cote client\n(montant > 0, client selectionne)
}

VALIDATING --> DRAFT       : Erreur validation\n(champ manquant / montant invalide)
VALIDATING --> SENDING     : Validation OK - connexion disponible
VALIDATING --> PENDING_SYNC : Validation OK - hors ligne

state SENDING {
  [*] --> http_post
  http_post : POST /api/v1/collectes\n(Spring Boot API)\nCookie: imf_access
}

SENDING --> CONFIRMED    : 201 Created
SENDING --> DUPLICATE    : 409 Conflict\n(doublon detecte)
SENDING --> PENDING_SYNC : Erreur reseau / timeout

state CONFIRMED {
  CONFIRMED : uid confirme par le serveur
}

CONFIRMED : entry / Sauvegarde SQLite (historique)
CONFIRMED : entry / Affiche toast "Collecte enregistree"
CONFIRMED --> [*]

state DUPLICATE {
  DUPLICATE : Collecte deja existante (meme uid)
}

DUPLICATE : entry / Affiche message erreur
DUPLICATE : entry / Log local (statut=DOUBLON)
DUPLICATE --> [*]

state PENDING_SYNC {
  [*] --> local_saved
  local_saved : INSERT SQLite\nstatut = PENDING_SYNC
  local_saved --> waiting_connectivity
  waiting_connectivity : En attente reconnexion\n(ConnectivityPlus)
}

PENDING_SYNC : entry / INSERT SQLite (offline)
PENDING_SYNC : entry / Affiche badge hors ligne
PENDING_SYNC : do / SyncService ecoute ConnectivityPlus
PENDING_SYNC --> SYNCING : Retour connectivite detecte

state SYNCING {
  [*] --> retry_post
  retry_post : POST /api/v1/collectes (retry)\nCookie: imf_access
}

SYNCING --> CONFIRMED  : 201 Created (sync reussie)
SYNCING --> DUPLICATE  : 409 Conflict
SYNCING --> SYNC_ERROR : 5xx / Timeout

state SYNC_ERROR {
  SYNC_ERROR : Erreur de synchronisation\nretryCount incremente
}

SYNC_ERROR : entry / Notification "Echec sync"
SYNC_ERROR : do / Retry automatique (3 max)
SYNC_ERROR --> SYNCING  : retryCount < 3\n(delai exponentiel)
SYNC_ERROR --> FAILED   : retryCount >= 3

state FAILED {
  FAILED : Intervention manuelle requise
}

FAILED : entry / Alerte utilisateur
FAILED : entry / Log pour DSI
FAILED --> [*]

@enduml
