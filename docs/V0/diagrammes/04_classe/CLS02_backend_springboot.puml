@startuml CLS02_backend_springboot
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam class {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
}
skinparam enum {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
}

title CLS02 - Diagramme de Classes - Backend Spring Boot 3.3 / Java 21\nEntites JPA + Services + Controllers

' ===== ENTITES JPA =====
class User <<@Entity>> {
  - uid : UUID <<@Id>>
  - email : String <<@Column unique>>
  - nomComplet : String
  - role : String
  - fcmToken : String
  - actif : boolean
  - lastLogin : LocalDateTime
}

class Agence <<@Entity>> {
  - uid : UUID <<@Id>>
  - nom : String
  - actif : boolean
}

class ClientInformel <<@Entity>> {
  - uid : UUID <<@Id>>
  - nom : String
  - prenom : String
  - telephone : String
  - secteurActivite : String
  - dateAdhesion : LocalDate
}

class DossierCredit <<@Entity>> {
  - uid : UUID <<@Id>>
  - montantDemande : BigDecimal
  - dureeMois : Integer
  - statut : StatutDossier <<@Enumerated>>
  - dateDecision : LocalDateTime
}

enum StatutDossier {
  INSTRUCTION
  EN_COMITE
  APPROUVE
  REJETE
  AJOURNE
  DEBLOQUE
}

class ContratCredit <<@Entity>> {
  - uid : UUID <<@Id>>
  - referenceContrat : String
  - montantFinal : BigDecimal
  - tauxInteret : BigDecimal
  - nbEcheances : Integer
  - statut : StatutContrat <<@Enumerated>>
  - signaturesConformes : boolean
}

enum StatutContrat {
  BROUILLON
  SOUMIS
  VALIDE
  ACTIF
  REJETE
}

class Creance <<@Entity>> {
  - uid : UUID <<@Id>>
  - montantTotal : BigDecimal
  - montantRembourse : BigDecimal
  - joursRetard : Integer
  - statut : StatutPret <<@Enumerated>>
  - classeCOBAC : Character
}

enum StatutPret {
  ACTIF
  EN_RETARD
  EN_RECOUVREMENT
  SOLDE
  PERTE
}

class CollecteTerrain <<@Entity>> {
  - uid : UUID <<@Id>>
  - montantCollecte : BigDecimal
  - canal : String
  - statut : StatutCollecte <<@Enumerated>>
  - synchronise : boolean
  - dateCollecte : LocalDate
}

enum StatutCollecte {
  SOUMISE
  CONFIRMEE
  REJETEE
}

class AlerteImpaye <<@Entity>> {
  - uid : UUID <<@Id>>
  - joursRetard : Integer
  - montantEnRetard : BigDecimal
  - statutAlerte : StatutAlerte <<@Enumerated>>
  - sseSent : boolean
  - emailSent : boolean
  - fcmSent : boolean
}

enum StatutAlerte {
  ACTIVE
  ESCALADEE
  CLOTUREE
}

class OtpCode <<@Entity>> {
  - uid : UUID <<@Id>>
  - codeHash : String
  - expiresAt : LocalDateTime
  - tentatives : Integer
}

class RefreshToken <<@Entity>> {
  - uid : UUID <<@Id>>
  - tokenHash : String <<@Column unique>>
  - expiresAt : LocalDateTime
}

' ===== REPOSITORIES =====
interface UserRepository <<@Repository>> {
  + findByEmail(email: String) : Optional<User>
  + findByRoleAndActif(role, actif) : List<User>
}

interface CreanceRepository <<@Repository>> {
  + findByStatutAndJoursRetardGreaterThan(statut, jours) : List<Creance>
}

interface AlerteRepository <<@Repository>> {
  + findByStatutAlerte(statut) : List<AlerteImpaye>
  + countByStatutAlerte(statut) : long
}

' ===== SERVICES =====
class AuthService <<@Service>> {
  - userRepo : UserRepository
  - otpRepo : OtpRepository
  - jwtProvider : JwtTokenProvider
  + requestOtp(email: String) : void
  + verifyOtp(email: String, code: String) : AuthResponse
  + refresh(refreshToken: String) : AuthResponse
  + logout(refreshToken: String) : void
}

class KpiService <<@Service>> {
  + getKpis(params: KpiParams) : KpiResponse
  + getDashboardSummary() : DashboardSummaryResponse
}

class AlerteService <<@Service>> {
  - alerteRepo : AlerteRepository
  - sseService : SseService
  + getActiveAlertes() : List<AlerteResponse>
  + cloturerAlerte(uid: UUID) : AlerteResponse
  + escaladerAlerte(uid: UUID) : AlerteResponse
}

class SseService <<@Service>> {
  - sseEmitters : Map<UUID, SseEmitter>
  + subscribe(userId: UUID) : SseEmitter
  + sendNotification(userId: UUID, event: String) : void
  + broadcastToRole(role: String, event: NotifEvent) : void
}

' ===== CONTROLLERS =====
class AuthController <<@RestController>> {
  + requestOtp(@RequestParam email) : ResponseEntity
  + verifyOtp(@RequestBody req) : ResponseEntity<AuthResponse>
  + refresh(@CookieValue imf_refresh) : ResponseEntity
  + logout(@CookieValue imf_refresh) : ResponseEntity
}

class DirecteurController <<@RestController>> {
  + getKpis(@RequestParam params) : ResponseEntity<KpiResponse>
  + getDashboard() : ResponseEntity<DashboardSummaryResponse>
}

class AlerteController <<@RestController>> {
  + getAlertes(@RequestParam statut) : ResponseEntity
  + updateStatut(@PathVariable uid, @RequestBody req) : ResponseEntity
}

class SseController <<@RestController>> {
  + stream(@CookieValue imf_access) : SseEmitter
}

class JwtTokenProvider <<@Component>> {
  - secretKey : String
  - accessTokenExpiry : long = 900000
  + generateAccessToken(user: User) : String
  + generateRefreshToken() : String
  + validateToken(token: String) : boolean
  + extractUserId(token: String) : UUID
}

' ===== RELATIONS =====
DossierCredit --> StatutDossier
ContratCredit --> StatutContrat
Creance --> StatutPret
CollecteTerrain --> StatutCollecte
AlerteImpaye --> StatutAlerte

AuthController --> AuthService
DirecteurController --> KpiService
AlerteController --> AlerteService
SseController --> SseService

AuthService --> UserRepository
AuthService --> JwtTokenProvider
AlerteService --> AlerteRepository
AlerteService --> SseService

UserRepository ..> User : manages
CreanceRepository ..> Creance : manages
AlerteRepository ..> AlerteImpaye : manages

@enduml
