@startuml CLS03_flutter_app
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam class {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
}
skinparam enum {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
}

title CLS03 - Diagramme de Classes - Application Flutter 3.24\nArchitecture Provider 6.1 + Repository Pattern

' ===== MODELS (Dart) =====
class UserModel {
  + uid : String
  + email : String
  + role : String
  + nomComplet : String
  + fromJson(json: Map) : UserModel <<factory>>
  + toJson() : Map<String, dynamic>
}

class CollecteModel {
  + uid : String
  + clientId : String
  + montantCollecte : double
  + canal : String
  + referenceTransaction : String?
  + dateCollecte : DateTime
  + statut : SyncStatus
  + retryCount : int
  + fromJson(json: Map) : CollecteModel <<factory>>
  + toJson() : Map<String, dynamic>
}

enum SyncStatus {
  PENDING_SYNC
  CONFIRMEE
  DOUBLON
  SYNC_ERROR
}

class AlerteModel {
  + uid : String
  + clientNom : String
  + joursRetard : int
  + montantEnRetard : double
  + statut : String
  + fromJson(json: Map) : AlerteModel <<factory>>
}

class KpiDashboardModel {
  + totalCollectes : double
  + par30 : double
  + par90 : double
  + nbAlertes : int
  + trendPar30 : List<TrendPoint>
  + lastUpdated : DateTime
  + fromJson(json: Map) : KpiDashboardModel <<factory>>
}

class TrendPoint {
  + dateSnapshot : DateTime
  + valeur : double
}

' ===== REPOSITORIES =====
abstract class BaseRepository {
  # apiClient : ApiClient
  # localDb : LocalDatabase
}

class AuthRepository {
  + requestOtp(email: String) : Future<void>
  + verifyOtp(email: String, code: String) : Future<UserModel>
  + refreshToken() : Future<void>
  + logout() : Future<void>
}

class CollecteRepository {
  + soumettre(c: CollecteModel) : Future<CollecteModel>
  + getPendingSync() : Future<List<CollecteModel>>
  + saveLocally(c: CollecteModel) : Future<void>
  + updateSyncStatus(uid: String, s: SyncStatus) : Future<void>
}

class KpiRepository {
  + getDashboardSummary() : Future<KpiDashboardModel>
  + getKpis(params: Map) : Future<KpiResponse>
}

class AlerteRepository {
  + getAlertes(statut: String?) : Future<List<AlerteModel>>
  + cloturerAlerte(uid: String) : Future<void>
  + escaladerAlerte(uid: String) : Future<void>
}

' ===== PROVIDERS (Provider 6.1) =====
class AuthProvider <<ChangeNotifier>> {
  - _authRepo : AuthRepository
  - _user : UserModel?
  - _fcmService : FcmService
  + requestOtp(email: String) : Future<void>
  + verifyOtp(email: String, code: String) : Future<void>
  + logout() : Future<void>
  + isAuthenticated : bool
  + currentUser : UserModel?
}

class DashboardProvider <<ChangeNotifier>> {
  - _kpiRepo : KpiRepository
  - _data : KpiDashboardModel?
  - _cacheTime : DateTime?
  + fetchData() : Future<void>
  + refresh() : Future<void>
  + isExpired() : bool
}

class CollecteProvider <<ChangeNotifier>> {
  - _collecteRepo : CollecteRepository
  - _state : CollecteFormState
  + soumettre(c: CollecteModel) : Future<void>
  + reset() : void
}

class SyncService <<ChangeNotifier>> {
  - _collecteRepo : CollecteRepository
  + startListening() : void
  + syncPending() : Future<SyncResult>
  + onConnectivityChanged(result) : void
}

' ===== API CLIENT =====
class ApiClient {
  - _client : http.Client
  - _baseUrl : String
  + get(path: String, params: Map?) : Future<Response>
  + post(path: String, data: Map) : Future<Response>
  + put(path: String, data: Map) : Future<Response>
  + handleRefreshOn401() : Future<void>
}

' ===== BASE DE DONNEES LOCALE =====
class LocalDatabase {
  - _db : Database?
  + open() : Future<void>
  + insert(table: String, data: Map) : Future<int>
  + query(table: String, where?, args?) : Future<List<Map>>
  + update(table: String, data: Map, where, args) : Future<int>
}

' ===== SERVICE NOTIFICATIONS =====
class FcmService {
  + initialize() : Future<void>
  + getToken() : Future<String?>
  + onForegroundMessage(msg: RemoteMessage) : void
  + onBackgroundMessage(msg: RemoteMessage) : Future<void>
  + handleNavigation(data: Map) : void
}

' ===== SCREENS (Views) =====
class LoginScreen {
  + build(context: BuildContext) : Widget
}

class OtpScreen {
  + build(context: BuildContext) : Widget
}

class DashboardScreen {
  + build(context: BuildContext) : Widget
}

class CollecteScreen {
  + build(context: BuildContext) : Widget
}

class AlertesScreen {
  + build(context: BuildContext) : Widget
}

' ===== RELATIONS =====
CollecteModel --> SyncStatus
KpiDashboardModel --> TrendPoint

AuthProvider --> AuthRepository
AuthProvider --> FcmService
DashboardProvider --> KpiRepository
CollecteProvider --> CollecteRepository
SyncService --> CollecteRepository

AuthRepository --> ApiClient
CollecteRepository --> ApiClient
CollecteRepository --> LocalDatabase
KpiRepository --> ApiClient
AlerteRepository --> ApiClient

LoginScreen --> AuthProvider
OtpScreen --> AuthProvider
DashboardScreen --> DashboardProvider
CollecteScreen --> CollecteProvider
AlertesScreen --> AlerteRepository

BaseRepository <|-- AuthRepository
BaseRepository <|-- CollecteRepository
BaseRepository <|-- KpiRepository
BaseRepository <|-- AlerteRepository

@enduml
