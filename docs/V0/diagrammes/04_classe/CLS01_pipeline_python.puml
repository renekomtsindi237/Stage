@startuml CLS01_pipeline_python
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam class {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
}
skinparam enum {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
}

title CLS01 - Diagramme de Classes - Pipeline Python\nCouche Data Engineering (Airflow 2.8.4 + dbt Core 1.8)

abstract class DataSource {
  - source_name : str
  - last_processed : datetime
  + fetch_data() : DataFrame
  + validate_schema() : bool
}

class MTNApiSource {
  - api_key : str
  - base_url : str
  - operateur : str = "MTN"
  + fetch_data() : DataFrame
  + normalize_columns() : DataFrame
}

class OrangeApiSource {
  - api_key : str
  - base_url : str
  - operateur : str = "ORANGE"
  + fetch_data() : DataFrame
  + normalize_columns() : DataFrame
}

class CBSDataSource {
  - host : str
  - encoding : str = "latin-1"
  - date_format : str = "%d/%m/%Y"
  + fetch_data() : DataFrame
  + parse_dates() : DataFrame
}

class MobileDataSource {
  - agent_id : str
  - endpoint : str
  + fetch_data() : DataFrame
}

abstract class Transformer {
  - source_schema : str
  - target_schema : str
  - db_connection : Engine
  + run() : TransformResult
  + validate() : bool
}

class Deduplicator {
  - uuid_columns : list[str]
  - table_name : str
  + compute_uuid(row: dict) : str
  + deduplicate_intra_batch(df: DataFrame) : DataFrame
  + get_stats() : DedupStats
}

class SchemaValidator {
  - expected_columns : list[str]
  - type_mapping : dict
  + validate(df: DataFrame) : ValidationResult
  + coerce_types(df: DataFrame) : DataFrame
}

class DbtTransformer {
  - dbt_project_path : str
  - models_to_run : list[str]
  + run() : DbtResult
  + run_tests() : DbtTestResult
}

class AlertManager {
  - spring_api_url : str
  - seuil_jours : int = 30
  - max_retries : int = 3
  + detect_impayes() : list[AlerteDto]
  + generate_alert(clientId: str, joursRetard: int) : AlerteDto
  + trigger_notifications(alerte: AlerteDto) : bool
  + close_resolved_alerts() : int
}

class AlerteDto {
  - uid : str
  - clientId : str
  - joursRetard : int
  - montantEnRetard : float
  - statut : str
  + to_api_payload() : dict
}

class DAGRunner {
  - dag_id : str
  - schedule_cron : str
  - tasks : list[Task]
  + trigger(execution_date: date) : RunResult
  + get_status() : str
  + backfill(start_date: date, end_date: date) : void
  + on_failure_callback(context: dict) : void
}

class PipelineLogger {
  - db_connection : Engine
  + log_ingestion(source: str, inserted: int, dupes: int) : void
  + log_transform(model: str, rows: int) : void
  + log_error(source: str, error: Exception) : void
}

DataSource <|-- MTNApiSource
DataSource <|-- OrangeApiSource
DataSource <|-- CBSDataSource
DataSource <|-- MobileDataSource
Transformer <|-- Deduplicator
Transformer <|-- DbtTransformer

AlertManager --> AlerteDto : cree
DAGRunner --> DataSource : orchestre 1..*
DAGRunner --> Transformer : orchestre 1..*
DAGRunner --> AlertManager : orchestre
DAGRunner --> PipelineLogger : utilise
Deduplicator --> SchemaValidator : utilise

@enduml
