@startuml CLS05_ml_scoring
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
  ArrowColor #333333
}
skinparam enum {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}
skinparam ArrowColor #333333
skinparam ArrowThickness 1

title CLS05 - Architecture du scoring MCRS

enum NiveauRisque {
  FAIBLE
  MODERE
  ELEVE
  CRITIQUE
}

note right of NiveauRisque
  Seuils (scoring_config.json) :
  FAIBLE   < 0.30
  MODERE   0.30 - 0.55
  ELEVE    0.55 - 0.75
  CRITIQUE >= 0.75
end note

class CRSCalculator {
  - config : dict
  + calculer(clientId : str, features : dict) : float
}

note right of CRSCalculator
  Collection Reliability Score
  regularite_collecte_pct x0.30
  nb_collectes_30j_normalise x0.20
  taux_remboursement_hist x0.25
  absence_semaines_penalite x0.15
  stabilite_montants x0.10
end note

class RPSCalculator {
  - config : dict
  + calculer(clientId : str, features : dict) : float
}

note right of RPSCalculator
  Recovery Performance Score
  taux_recouvrement_global x0.35
  par_30_jours x0.25
  delai_moyen_recouvrement x0.20
  historique_plan_apurement x0.20
end note

class CSICalculator {
  - config : dict
  + calculer(clientId : str, features : dict) : float
}

note right of CSICalculator
  Client Scoring Index
  indice_resilience x0.35
  capacite_remboursement x0.30
  pression_prix x0.15
  pression_climatique x0.10
  diversification x0.10
end note

class MCRSAggregator {
  - w_crs : float = 0.35
  - w_rps : float = 0.45
  - w_csi : float = 0.20
  + calculer_mcrs(crs, rps, csi : float) : float
  + classifier(mcrs : float) : NiveauRisque
  + batch_score(df : DataFrame) : DataFrame
}

note bottom of MCRSAggregator
  MCRS = 0.35 x (1-CRS) + 0.45 x RPS_risk + 0.20 x CSI_risk
  Score in [0.000, 1.000] - 1 = risque maximum
end note

class XGBoostModel {
  - model : XGBClassifier
  - feature_names : List[str]
  - version : str
  + charger_depuis_db(model_run_id : str) : void
  + predict_proba(features : ndarray) : float
  + get_importances() : Dict[str, float]
}

class SHAPExplainer {
  - explainer : shap.TreeExplainer
  + calculer_shap(model, features) : ndarray
  + sauvegarder(clientId, shap_values) : void
  + top_features(n : int) : List
}

class PSIMonitor {
  - psi_seuil : float = 0.20
  - check_freq_jours : int = 7
  + calculer_psi(baseline, actuel) : float
  + detecter_derive() : bool
  + declencher_retrain() : void
}

class MCRSFastAPIService {
  ' FastAPI 0.111 - Python 3.11 - :8090
  + score_client(clientId : str) : ScoreResponse
  + score_batch(clientIds : List) : List[ScoreResponse]
  + shap_client(clientId : str) : SHAPResponse
  + health() : dict
}

class ScoreResponse {
  + clientId : str
  + scoreMcrs : float
  + scoreCrs : float
  + scoresRps : float
  + scoresCsi : float
  + niveauRisque : NiveauRisque
  + dateCalcul : datetime
  + topFeatures : List[dict]
}

class MLRepository {
  ' PostgreSQL schema ml
  + sauvegarder_score(s : ScoreResponse) : void
  + sauvegarder_shap(clientId, values) : void
  + charger_modele_actif() : XGBoostModel
}

MCRSFastAPIService --> MCRSAggregator
MCRSFastAPIService --> MLRepository
MCRSFastAPIService --> ScoreResponse

MCRSAggregator --> CRSCalculator
MCRSAggregator --> RPSCalculator
MCRSAggregator --> CSICalculator
MCRSAggregator --> XGBoostModel
MCRSAggregator --> NiveauRisque

XGBoostModel --> SHAPExplainer
SHAPExplainer --> MLRepository
MLRepository ..> XGBoostModel : charge modele actif

PSIMonitor --> MLRepository
PSIMonitor ..> MCRSAggregator : re-scoring si derive

@enduml
