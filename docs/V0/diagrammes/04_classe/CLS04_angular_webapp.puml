@startuml CLS04_angular_webapp
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam class {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
}
skinparam package {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title CLS04 - Diagramme de Classes - Application Web Angular 17\nArchitecture modules + services + composants

package "Models (DTOs)" {
  class KpiCollecteDto {
    + agenceId : string
    + montantJour : number
    + montantMois : number
    + trendSemaine : TrendPoint[]
  }
  class KpiRecouvrementDto {
    + agenceId : string
    + tauxPar30 : number
    + tauxPar90 : number
    + encoursTotalPar30 : number
    + nbCreancesRetard : number
  }
  class AlerteDto {
    + uid : string
    + clientNom : string
    + joursRetard : number
    + montantEnRetard : number
    + statutAlerte : string
  }
  class TrendPoint {
    + dateSnapshot : string
    + valeur : number
  }
  class AuthResponse {
    + role : string
    + nomComplet : string
  }
}

package "Core" {
  class JwtInterceptor {
    + intercept(req, next) : Observable<HttpEvent>
    - handle401(req, next) : Observable<HttpEvent>
  }
  class AuthGuard {
    + canActivate(route, state) : boolean | UrlTree
  }
  class RoleGuard {
    + canActivate(route, state) : boolean | UrlTree
    - extractRequiredRoles(route) : string[]
  }
  class SseService {
    - eventSource : EventSource
    + connect() : Observable<NotifEvent>
    + disconnect() : void
  }
}

package "AuthModule" {
  class AuthService {
    - currentUserSignal : Signal<AuthResponse | null>
    + requestOtp(email: string) : Observable<void>
    + verifyOtp(email: string, code: string) : Observable<AuthResponse>
    + logout() : Observable<void>
    + isAuthenticated() : boolean
    + hasRole(role: string) : boolean
    + getCurrentUser() : AuthResponse | null
  }
  class LoginComponent {
    - form : FormGroup
    + onSubmit() : void
  }
  class OtpComponent {
    - form : FormGroup
    + onSubmit() : void
  }
}

package "DirecteurFeature" {
  class KpiService {
    + getDashboardSummary() : Observable<DashboardSummaryDto>
    + getCollecteKpis(params) : Observable<KpiCollecteDto[]>
    + getRecouvrementKpis(params) : Observable<KpiRecouvrementDto[]>
  }
  class DashboardComponent {
    - summary : DashboardSummaryDto | null
    + ngOnInit() : void
    + onRefresh() : void
  }
  class KpiCardComponent {
    + label : string
    + value : number
    + unit : string
  }
  class NotifPanelComponent {
    - alertes : AlerteDto[]
    + ngOnInit() : void
    + onBadgeClick() : void
  }
}

package "AnalysteFeature" {
  class ScoringService {
    + getScoringClient(uid: string) : Observable<ScoringDto>
    + getShapExplanations(uid: string) : Observable<ShapDto>
  }
  class ScoringComponent {
    + ngOnInit() : void
  }
}

package "SaisieFeature" {
  class DossierService {
    + creerDossier(req) : Observable<DossierDto>
    + listerDossiers(params) : Observable<DossierDto[]>
    + validerContrat(uid: string) : Observable<void>
  }
  class DossierFormComponent {
    + onSubmit() : void
  }
}

package "DsiFeature" {
  class PipelineService {
    + getDagStatus() : Observable<DagStatusDto[]>
    + triggerDag(dagId: string) : Observable<void>
  }
  class PipelineComponent {
    + ngOnInit() : void
    + onTrigger(dagId: string) : void
  }
}

class AppRoutingModule {
  + routes : Routes
}

' ===== RELATIONS =====
LoginComponent --> AuthService
OtpComponent --> AuthService
AuthGuard --> AuthService
RoleGuard --> AuthService
JwtInterceptor --> AuthService

DashboardComponent --> KpiService
DashboardComponent --> KpiCardComponent
NotifPanelComponent --> SseService
NotifPanelComponent --> AlerteDto

ScoringComponent --> ScoringService
DossierFormComponent --> DossierService
PipelineComponent --> PipelineService

AppRoutingModule --> AuthGuard
AppRoutingModule --> RoleGuard

KpiCollecteDto --> TrendPoint

@enduml
