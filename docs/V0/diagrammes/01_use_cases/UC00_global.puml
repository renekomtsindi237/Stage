@startuml UC00_global
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam actorStyle none
skinparam usecase {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #888888
}

title UC00 - Diagramme de cas d'utilisation global\nMicroRecouv - 6 roles

left to right direction

actor "Directeur\n(DIRECTEUR)" as DIR
actor "Analyste Credit\n(ANALYSTE_CREDIT)" as ANA
actor "Agent Terrain\n(AGENT_TERRAIN)" as AT
actor "DSI\n(DSI)" as DSI
actor "Agent de Saisie\n(AGENT_SAISIE)" as SAI
actor "Administrateur\n(ADMIN_SYSTEME)" as ADM

actor "MTN MoMo API" as MTN
actor "Orange Money API" as OM
actor "CBS Core Banking" as CBS
actor "SMTP" as SMTP
actor "GROQ API" as GROQ

rectangle "MicroRecouv" {
  usecase "UC01 - Consulter KPI\net alertes (dashboard)" as UC01
  usecase "UC02 - Suivre portefeuille\nde creances (PAR)" as UC02
  usecase "UC03 - Gerer recouvrement\net plans d'apurement" as UC03
  usecase "UC04 - Analyser scoring ML\n(MCRS + SHAP)" as UC04
  usecase "UC05 - Administrer\nle pipeline" as UC05
  usecase "UC06 - Saisir collecte\n(mobile offline-first)" as UC06
  usecase "UC07 - Gerer contrats\net dossiers credit" as UC07
  usecase "UC08 - S'authentifier\n(email + OTP)" as UC08
  usecase "UC09 - Importer donnees\n(Excel/CSV)" as UC09
  usecase "UC10 - Chatbot IA\n(assistant metier)" as UC10
}

DIR --> UC01
DIR --> UC02
DIR --> UC03
DIR --> UC09
DIR --> UC10

ANA --> UC02
ANA --> UC04
ANA --> UC10

AT  --> UC06
AT  --> UC10

DSI --> UC05
DSI --> UC01
DSI --> UC10

SAI --> UC07

ADM --> UC05

MTN --> UC01
OM  --> UC01
CBS --> UC02
UC08 --> SMTP
UC10 --> GROQ

UC01 ..> UC08 : <<include>>
UC02 ..> UC08 : <<include>>
UC03 ..> UC08 : <<include>>
UC04 ..> UC08 : <<include>>
UC05 ..> UC08 : <<include>>
UC06 ..> UC08 : <<include>>
UC07 ..> UC08 : <<include>>

@enduml
