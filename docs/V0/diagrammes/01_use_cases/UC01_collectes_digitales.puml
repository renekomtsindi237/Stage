@startuml UC01_collectes_digitales
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam actorStyle none
skinparam usecase {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title UC01 - Gestion des Collectes Digitales

left to right direction

actor "Analyste Credit\n(ANALYSTE_CREDIT)" as ANA
actor "Agent de Saisie\n(AGENT_SAISIE)" as SAI
actor "MTN MoMo API" as MTN <<systeme>>
actor "Orange Money API" as OM <<systeme>>
actor "Core Banking System" as CBS <<systeme>>
actor "DSI\n(DSI)" as DSI

rectangle "UC01 - Gestion des Collectes Digitales" {

  usecase "UC01.1\nIngerer transactions\nMTN (API quotidienne)" as UC0101
  usecase "UC01.2\nIngerer transactions\nOrange Money (API quotidienne)" as UC0102
  usecase "UC01.3\nRapprocher transactions\n/ CBS (3 passes)" as UC0103
  usecase "UC01.4\nDedupliquer\ntransactions (UUID)" as UC0104
  usecase "UC01.5\nConsulter volume\net tendances collectes" as UC0105
  usecase "UC01.6\nFiltrer par canal,\nagence, agent, periode" as UC0106
  usecase "UC01.7\nExporter donnees\ncollectes (CSV)" as UC0107
  usecase "UC01.8\nReingerer un lot\nen erreur" as UC0108
  usecase "UC01.9\nVisualiser dashboard\nCollectes (web Angular)" as UC0109

}

ANA  --> UC0105
ANA  --> UC0106
ANA  --> UC0107
SAI  --> UC0108
DSI  --> UC0108

MTN  --> UC0101
OM   --> UC0102
CBS  --> UC0103

UC0101 ..> UC0104 : <<include>>
UC0102 ..> UC0104 : <<include>>
UC0104 ..> UC0103 : <<include>>

UC0105 ..> UC0106 : <<extend>>
UC0105 ..> UC0107 : <<extend>>
UC0105 ..> UC0109 : <<include>>

@enduml
