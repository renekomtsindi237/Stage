@startuml UC03_recouvrement_relances
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam actorStyle none
skinparam usecase {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title UC03 - Recouvrement et Relances

left to right direction

actor "Directeur\n(DIRECTEUR)" as DIR
actor "SMTP" as SMTP <<systeme>>
actor "Firebase FCM\n(push mobile)" as FCM <<systeme>>
actor "Airflow Scheduler" as SCH <<systeme>>

rectangle "UC03 - Recouvrement et Relances" {

  usecase "UC03.1\nDetecter creances\nechues automatiquement\n(dag_alertes_impayes)" as UC0301
  usecase "UC03.2\nGenerer alerte impaye\n(INSERT AlerteImpaye)" as UC0302
  usecase "UC03.3\nEnvoyer notification\nSSE (web temps reel)" as UC0303
  usecase "UC03.4\nEnvoyer notification\nemail SMTP" as UC0304
  usecase "UC03.5\nEnvoyer notification\npush FCM (mobile)" as UC0305
  usecase "UC03.6\nConsulter liste\nalertes actives" as UC0306
  usecase "UC03.7\nCloture manuelle\nd'une alerte" as UC0307
  usecase "UC03.8\nEscalader une alerte\n(passage PAR90)" as UC0308
  usecase "UC03.9\nCreer plan\nd'apurement" as UC0309

}

DIR --> UC0306
DIR --> UC0307
DIR --> UC0308
DIR --> UC0309

SCH     --> UC0301
UC0304  --> SMTP
UC0305  --> FCM

UC0301 ..> UC0302 : <<include>>
UC0302 ..> UC0303 : <<include>>
UC0302 ..> UC0304 : <<extend>>
UC0302 ..> UC0305 : <<extend>>
UC0306 ..> UC0307 : <<extend>>
UC0306 ..> UC0308 : <<extend>>
UC0308 ..> UC0303 : <<include>>

@enduml
