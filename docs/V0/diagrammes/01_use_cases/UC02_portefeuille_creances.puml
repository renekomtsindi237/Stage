@startuml UC02_portefeuille_creances
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam actorStyle none
skinparam usecase {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title UC02 - Suivi du Portefeuille de Creances (PAR)

left to right direction

actor "Directeur\n(DIRECTEUR)" as DIR
actor "Analyste Credit\n(ANALYSTE_CREDIT)" as ANA
actor "Core Banking System" as CBS <<systeme>>

rectangle "UC02 - Suivi du portefeuille de creances" {

  usecase "UC02.1\nCalculer PAR30 et PAR90\n(quotidien, par agence)" as UC0201
  usecase "UC02.2\nCalculer taux\nde recouvrement\n(par agent / agence)" as UC0202
  usecase "UC02.3\nScorer le risque client\n(MCRS via FastAPI)" as UC0203
  usecase "UC02.4\nVisualiser evolution\ndu PAR (graphique tendance)" as UC0204
  usecase "UC02.5\nConsulter la liste\ndes creances en retard" as UC0205
  usecase "UC02.6\nFiltrer par agence,\nagent, produit, periode" as UC0206
  usecase "UC02.7\nExporter creances\na risque (CSV)" as UC0207
  usecase "UC02.8\nConsulter la classification\nCOBAC (classes A-E)" as UC0208

}

DIR --> UC0204
DIR --> UC0205
ANA --> UC0202
ANA --> UC0203
ANA --> UC0207
ANA --> UC0208

CBS --> UC0201
CBS --> UC0202

UC0201 ..> UC0204 : <<include>>
UC0204 ..> UC0206 : <<extend>>
UC0205 ..> UC0206 : <<extend>>
UC0205 ..> UC0207 : <<extend>>
UC0205 ..> UC0208 : <<extend>>

@enduml
