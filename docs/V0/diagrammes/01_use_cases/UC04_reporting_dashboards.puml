@startuml UC04_reporting_dashboards
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam actorStyle none
skinparam usecase {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title UC04 - Reporting et Tableaux de Bord (Angular 17)

left to right direction

actor "Directeur\n(DIRECTEUR)" as DIR
actor "Analyste Credit\n(ANALYSTE_CREDIT)" as ANA
actor "DSI\n(DSI)" as DSI

rectangle "UC04 - Reporting et Tableaux de Bord" {

  usecase "UC04.1\nS'authentifier\n(email + OTP)" as UC0401
  usecase "UC04.2\nConsulter dashboard\nCollectes (volume, canal, agence)" as UC0402
  usecase "UC04.3\nConsulter dashboard\nRecouvrement (PAR30/90, alertes)" as UC0403
  usecase "UC04.4\nConsulter dashboard\nexecutif (KPIs synthetiques)" as UC0404
  usecase "UC04.5\nFiltrer par\npériode, agence, agent" as UC0405
  usecase "UC04.6\nExporter donnees\nen CSV" as UC0406
  usecase "UC04.7\nVisualiser graphiques\n(courbes, barres, camembert)" as UC0407
  usecase "UC04.8\nConsulter alertes\nen temps reel (SSE)" as UC0408
  usecase "UC04.9\nConsulter scoring ML\n(MCRS, SHAP)" as UC0409

}

DIR --> UC0404
DIR --> UC0402
DIR --> UC0408
ANA --> UC0402
ANA --> UC0403
ANA --> UC0409
DSI --> UC0402

UC0402 ..> UC0401 : <<include>>
UC0403 ..> UC0401 : <<include>>
UC0404 ..> UC0401 : <<include>>
UC0402 ..> UC0407 : <<include>>
UC0403 ..> UC0407 : <<include>>

UC0402 ..> UC0405 : <<extend>>
UC0402 ..> UC0406 : <<extend>>
UC0403 ..> UC0405 : <<extend>>
UC0403 ..> UC0408 : <<extend>>

@enduml
