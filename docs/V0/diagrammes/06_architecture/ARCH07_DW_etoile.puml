@startuml ARCH07_DW_Etoile
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam entity {
  BackgroundColor white
  BorderColor #666666
  HeaderBackgroundColor #EEEEEE
  HeaderFontColor #333333
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ARCH07 - Schema analytique Data Warehouse\nSchemas dw + ml (PostgreSQL 15 - dbt Core 1.8)

' ═══════════════════════════════════════
' Tables dbt mart (schema dw)
' ═══════════════════════════════════════

entity "dw.mart_kpi_collecte" as MART_COL {
  * imf_id : UUID
  * agence_id : UUID
  * agent_id : UUID
  * date_snapshot : DATE
  --
  montant_jour : NUMERIC(15,2)
  montant_semaine : NUMERIC(15,2)
  montant_mois : NUMERIC(15,2)
  nb_transactions_jour : INTEGER
  montant_mobile_money : NUMERIC(15,2)
  montant_especes : NUMERIC(15,2)
  montant_virement : NUMERIC(15,2)
  variation_vs_semaine_precedente : NUMERIC(6,4)
  _dbt_updated_at : TIMESTAMP
}

entity "dw.mart_kpi_recouvrement" as MART_REC {
  * imf_id : UUID
  * agence_id : UUID
  * date_snapshot : DATE
  --
  encours_total : NUMERIC(15,2)
  encours_par30 : NUMERIC(15,2)
  encours_par60 : NUMERIC(15,2)
  encours_par90 : NUMERIC(15,2)
  taux_par30 : NUMERIC(6,4)
  taux_par60 : NUMERIC(6,4)
  taux_par90 : NUMERIC(6,4)
  nb_creances_actives : INTEGER
  nb_creances_en_retard : INTEGER
  taux_recouvrement_global : NUMERIC(6,4)
  _dbt_updated_at : TIMESTAMP
}

entity "dw.mart_benchmarks_agences" as MART_BEN {
  * imf_id : UUID
  * agence_id : UUID
  * date_snapshot : DATE
  --
  rang_agence : INTEGER
  score_performance : NUMERIC(4,3)
  taux_collecte_objectif : NUMERIC(6,4)
  taux_recouvrement : NUMERIC(6,4)
  par30_agence : NUMERIC(6,4)
  nb_agents_actifs : INTEGER
  _dbt_updated_at : TIMESTAMP
}

' ═══════════════════════════════════════
' Tables ML (schema ml)
' ═══════════════════════════════════════

entity "ml.features_client" as ML_FEAT {
  * clientId : UUID
  * date_feature : DATE
  --
  regularite_collecte_pct : NUMERIC(5,4)
  nb_collectes_30j : INTEGER
  taux_remboursement_hist : NUMERIC(5,4)
  taux_recouvrement_global : NUMERIC(5,4)
  par_30_jours : NUMERIC(5,4)
  delai_moyen_recouvrement : INTEGER
  anciennete_mois : INTEGER
  score_kyc : NUMERIC(4,3)
  _dbt_updated_at : TIMESTAMP
}

entity "ml.client_scores" as ML_SCORES {
  * uid : UUID
  * clientId : UUID
  * date_scoring : DATE
  --
  score_mcrs : NUMERIC(4,3)
  score_crs : NUMERIC(4,3)
  score_rps : NUMERIC(4,3)
  score_csi : NUMERIC(4,3)
  niveau_risque : VARCHAR(10)
  version_modele : VARCHAR(20)
  scored_at : TIMESTAMP
}

entity "ml.shap_explanations" as ML_SHAP {
  * uid : UUID
  * scoreId : UUID
  --
  feature_name : VARCHAR(100)
  shap_value : NUMERIC(8,6)
  feature_value : NUMERIC(15,4)
  rang_importance : INTEGER
  created_at : TIMESTAMP
}

entity "ml.model_runs" as ML_RUNS {
  * uid : UUID
  --
  version : VARCHAR(20)
  actif : BOOLEAN
  auc_roc : NUMERIC(5,4)
  precision_val : NUMERIC(5,4)
  recall_val : NUMERIC(5,4)
  psi_derive : NUMERIC(6,4)
  artefact_path : VARCHAR(500)
  trained_at : TIMESTAMP
}

' ═══════════════════════════════════════
' Sources dbt (schema staging)
' ═══════════════════════════════════════

entity "staging.stg_collectes_terrain" as STG_COL {
  * uid : UUID
  --
  clientId : UUID
  agentId : UUID
  montant_collecte : NUMERIC(15,2)
  date_collecte : DATE
  canal : VARCHAR(30)
  statut : VARCHAR(20)
}

entity "staging.stg_creances" as STG_CRE {
  * uid : UUID
  --
  clientId : UUID
  montant_total : NUMERIC(15,2)
  montant_rembourse : NUMERIC(15,2)
  jours_retard : INTEGER
  statut : VARCHAR(30)
  classe_cobac : CHAR(1)
}

' ═══════════════════════════════════════
' Relations
' ═══════════════════════════════════════

STG_COL   ..> MART_COL  : mart_kpi_collecte.sql
STG_CRE   ..> MART_REC  : mart_kpi_recouvrement.sql
MART_COL  ..> MART_BEN  : mart_benchmarks_agences.sql
MART_REC  ..> MART_BEN  : mart_benchmarks_agences.sql

ML_FEAT   ||--o{ ML_SCORES : "alimente scoring (1,n)"
ML_SCORES ||--o{ ML_SHAP   : "explique par SHAP (1,n)"
ML_RUNS   |o--o{ ML_SCORES : "version modele (0,n)"

note bottom of MART_COL
  Granularite : 1 ligne = 1 agent x 1 agence x 1 date
  Strategie dbt : incremental
  Calcule par : dag_kpis_quotidien (06h30)
end note

note bottom of ML_SCORES
  Calcule par : dag_ml_scoring (07h30)
  Via FastAPI :8090 - POST /score/{clientId}
  niveau_risque : FAIBLE/MODERE/ELEVE/CRITIQUE
end note

@enduml
