@startuml ARCH04_contexte_SI
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 8
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}
skinparam component {
  BackgroundColor white
  BorderColor #666666
}
skinparam actor {
  BackgroundColor white
  BorderColor #333333
}

title ARCH04 - Diagramme de Contexte SI\nMicroRecouv - Acteurs et flux externes

rectangle "MicroRecouv\n(Plateforme IMF Cameroun)" as SYSTEM {
  [Pipeline\nde donnees\n(Airflow + dbt)] as PIPELINE
  [Backend API\nSpring Boot 3.3] as BACKEND
  [App Web\nAngular 17] as WEB
  [App Mobile\nFlutter 3.24] as MOBILE
}

rectangle "Core Banking System\n(CBS)" as CBS
rectangle "MTN Mobile Money\nAPI" as MTN
rectangle "Orange Money\nAPI" as OM
rectangle "Firebase FCM\n(Google Cloud)" as FCM
rectangle "Serveur SMTP\n(email)" as SMTP
rectangle "GROQ API\n(LLM Chatbot)" as GROQ

actor "Directeur\n(DIRECTEUR)" as DIR
actor "Analyste Credit\n(ANALYSTE_CREDIT)" as ANA
actor "Agent Terrain\n(AGENT_TERRAIN)" as AT
actor "DSI\n(DSI)" as DSI
actor "Agent de Saisie\n(AGENT_SAISIE)" as SAI
actor "Administrateur\n(ADMIN_SYSTEME)" as ADM

' ===== FLUX ENTRANTS =====
CBS  --> PIPELINE : Export prets + creances\n(quotidien)
MTN  --> PIPELINE : Transactions API\n(quotidien)
OM   --> PIPELINE : Transactions API\n(quotidien)

' ===== FLUX SORTANTS =====
BACKEND --> FCM  : Push notifications\n(Firebase Admin SDK - mobile)
BACKEND --> SMTP : Alertes email\n(OTP + notifications)
BACKEND --> GROQ : Requetes LLM\n(chatbot metier)
FCM     --> AT   : Notification push\n(alerte impaye)
FCM     --> DIR  : Notification push\n(escalade)

' ===== ACTEURS HUMAINS WEB =====
DIR --> WEB : Dashboard executif\n(HTTPS - Angular)
ANA --> WEB : Dashboards analytiques\n+ scoring ML
DSI --> WEB : Admin + monitoring\npipeline
SAI --> WEB : Gestion contrats\net dossiers credit
ADM --> WEB : Administration\nsysteme

' ===== ACTEURS HUMAINS MOBILE =====
DIR    --> MOBILE : KPIs + alertes\n(app Flutter)
AT     --> MOBILE : Saisie collectes\n(online + offline)

@enduml
