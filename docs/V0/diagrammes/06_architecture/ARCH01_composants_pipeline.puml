@startuml ARCH01_composants_pipeline
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam component {
  BackgroundColor white
  BorderColor #666666
}
skinparam package {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}
skinparam database {
  BackgroundColor white
  BorderColor #666666
}

title ARCH01 - Pipeline de donnees MicroRecouv

package "Sources" {
  [MTN MoMo API\n(toutes les 2h)] as MTN
  [Orange Money API\n(toutes les 2h)] as OM
  [CBS - Core Banking\n(quotidien 06h00)] as CBS
  [App Mobile Flutter\n(collectes terrain)] as MOBILE
}

package "Orchestration - Apache Airflow 2.8.4 (:8089)" {
  [Airflow Scheduler] as SCHED
  [dag_ingestion_mtn / dag_ingestion_orange\ndag_ingestion_cbs] as DAG_ING
  [dag_collectes / dag_collecte_epargne\ndag_donnees_externes] as DAG_COL
  [dag_kpis_quotidien / dag_alertes_impayes\ndag_recouvrement] as DAG_KPI
  [dag_ml_scoring / dag_ml_training\ndag_monitoring / dag_backup] as DAG_ML
}

package "Transformation - dbt Core 1.8" {
  [Couche staging\n(stg_clients, stg_collectes_terrain\nstg_creances, stg_prix_produits)] as DBT_STG
  [Couche intermediate\n(int_* - agregats metier)] as DBT_INT
  [Couche mart\n(mart_kpi_collecte\nmart_kpi_recouvrement\nmart_benchmarks_agences)] as DBT_MART
  [Couche ml\n(ml_feat_* - feature engineering)] as DBT_ML
  [Tests qualite (schema.yml)] as DBT_TEST
}

package "API ML - FastAPI 0.111 (:8090)" {
  [MCRSScorer (CRS + RPS + CSI)] as SCORER
  [SHAPExplainer] as SHAP
  [PSIMonitor (derive)] as PSI
}

package "PostgreSQL 15 (:5432)" {
  database "raw\n(donnees brutes)" as RAW
  database "staging\n(stg_* nettoyes)" as STG
  database "intermediate\n(int_* agreges)" as INT
  database "dw\n(mart_kpi_*)" as DW
  database "ml\n(client_scores\nshap_explanations\nmodel_runs)" as ML
  database "app\n(44 entites operationnelles)" as APP
}

' -- Flux ingestion --
MTN    --> DAG_ING
OM     --> DAG_ING
CBS    --> DAG_ING
MOBILE --> DAG_COL

SCHED --> DAG_ING
SCHED --> DAG_COL
SCHED --> DAG_KPI
SCHED --> DAG_ML

DAG_ING --> RAW

' -- Flux transformation --
RAW --> DBT_STG
DBT_STG --> STG
STG  --> DBT_INT
DBT_INT --> INT
INT  --> DBT_MART
DBT_MART --> DW
DBT_MART --> DBT_TEST
STG  --> DBT_ML
DBT_ML --> ML

' -- Flux ML --
DAG_ML  --> SCORER
SCORER  --> ML
SCORER  --> SHAP
SHAP    --> ML
DAG_ML  --> PSI
PSI     --> ML

' -- Flux KPI/alertes --
DW     --> DAG_KPI
APP    --> DAG_KPI
DAG_KPI --> APP

@enduml
