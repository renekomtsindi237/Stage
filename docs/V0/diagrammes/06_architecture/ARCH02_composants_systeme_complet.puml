@startuml ARCH02_composants_systeme_complet
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam component {
  BackgroundColor white
  BorderColor #666666
}
skinparam package {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
  FontColor #333333
}
skinparam database {
  BackgroundColor white
  BorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ARCH02 - Architecture globale MicroRecouv

package "Sources externes" {
  [CBS - Core Banking] as CBS
  [MTN MoMo API] as MTN
  [Orange Money API] as OM
  [App Mobile Flutter] as MOBILE_SRC
}

package "Pipeline (Docker)" {
  [Apache Airflow 2.8.4\n:8089] as AIRFLOW
  [dbt Core 1.8] as DBT

  package "PostgreSQL 15 :5432" {
    database "app" as DB_APP
    database "raw" as DB_RAW
    database "staging" as DB_STG
    database "intermediate" as DB_INT
    database "dw" as DB_DW
    database "ml" as DB_ML
  }

  [Redis 7\n:6379] as REDIS
}

package "API REST - Spring Boot 3.3 / Java 21 (:8080)" {
  [AuthController\n/auth/**] as AUTH
  [DirecteurController\n/api/v1/directeur/**] as DIR
  [AnalysteController\n/api/v1/analyste/**] as ANA
  [CollecteController\n/api/v1/collectes/**] as COL
  [DsiController\n/api/v1/dsi/**] as DSI
  [BackOfficeController\n/api/v1/back-office/**] as BO
  [SseController\n/api/v1/sse/stream] as SSE
  [AiChatController\n/api/v1/ai/chat] as AI
  [Spring Security\n(JwtFilter + RBAC)] as SEC
}

package "API ML - FastAPI 0.111 / Python 3.11 (:8090)" {
  [MCRSScorer\n/score/{clientId}] as SCORER
  [SHAPExplainer\n/shap/{clientId}] as SHAP
}

package "Frontend Web - Angular 17 (:4200)" {
  [AuthModule] as ANG_AUTH
  [DirecteurFeature] as ANG_DIR
  [AnalysteFeature] as ANG_ANA
  [SaisieFeature] as ANG_SAI
  [DsiFeature] as ANG_DSI
  [NotificationPanel (SSE)] as ANG_NOTIF
}

package "Application Mobile - Flutter 3.24" {
  [AuthFeature] as FLT_AUTH
  [CollecteFeature\n(offline-first)] as FLT_COL
  [DashboardMobile] as FLT_DASH
  [SyncService] as FLT_SYNC
  database "SQLite (sqflite)" as SQLITE
}

package "Services externes" {
  [SMTP] as SMTP
  [GROQ API] as GROQ
}

' -- Flux pipeline --
CBS  --> AIRFLOW
MTN  --> AIRFLOW
OM   --> AIRFLOW
AIRFLOW --> DBT
AIRFLOW --> DB_RAW
DBT  --> DB_STG
DBT  --> DB_INT
DBT  --> DB_DW
DBT  --> DB_ML

' -- Flux backend --
SEC  --> AUTH
SEC  --> DIR
SEC  --> ANA
SEC  --> COL
SEC  --> DSI
SEC  --> BO
AUTH --> DB_APP
DIR  --> DB_DW
ANA  --> DB_ML
COL  --> DB_APP
AUTH --> SMTP
AUTH --> REDIS
AI   --> GROQ
SCORER --> DB_ML
SHAP   --> DB_ML

' -- Flux Nginx -> backend --
[Nginx 1.25 :80] as NGINX
NGINX --> AUTH
NGINX --> DIR
NGINX --> SSE
NGINX --> SCORER

' -- Flux Angular --
ANG_AUTH  --> NGINX
ANG_DIR   --> NGINX
ANG_ANA   --> NGINX
ANG_SAI   --> NGINX
ANG_DSI   --> NGINX
ANG_NOTIF --> NGINX

' -- Flux Flutter --
FLT_AUTH --> NGINX
FLT_COL  --> SQLITE
FLT_COL  --> NGINX
FLT_SYNC --> SQLITE
FLT_SYNC --> NGINX
MOBILE_SRC --> FLT_COL

@enduml
