@startuml ARCH03_deploiement
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam Padding 5
skinparam node {
  BackgroundColor white
  BorderColor #666666
}
skinparam component {
  BackgroundColor white
  BorderColor #666666
}
skinparam artifact {
  BackgroundColor white
  BorderColor #666666
}
skinparam package {
  BackgroundColor #F8F8F8
  BorderColor #AAAAAA
}

title ARCH03 - Diagramme de deploiement\nMicroRecouv - VPS 

node "Navigateur web" as BROWSER {
  artifact "Angular 17 (SPA)"
}

node "Smartphone Android/iOS" as PHONE {
  artifact "Flutter 3.24 (APK/IPA)"
}

node "VPS Ubuntu 22.04" as VPS {

  package "Docker Compose (reseau microrecouv_net)" {

    component "nginx 1.25\n:80, :443" as NGINX

    component "backend\nSpring Boot 3.3 / Java 21\n:8080 (interne)" as BACKEND

    component "frontend\nnginx (Angular build)\n:4200 -> :80 (interne)" as FRONTEND

    component "ml-api\nFastAPI 0.111 / Python 3.11\n:8090 (interne)" as ML

    component "airflow-web\nApache Airflow 2.8.4\n:8089 (interne)" as AIRFLOW

    component "airflow-scheduler" as AIRFLOW_SCHED

    component "postgres\nPostgreSQL 15-alpine\n:5432 (interne)" as PG

    component "redis\nRedis 7-alpine\n:6379 (interne)" as REDIS

    component "dbt\ndbt Core 1.8\n(no port - invoque par Airflow)" as DBT

    component "adminer\n:8888 (interne)" as ADMINER
  }
}

node "Services externes" {
  component "SMTP (email OTP)" as SMTP
  component "MTN MoMo API" as MTN
  component "Orange Money API" as OM
  component "GROQ API (LLM)" as GROQ
}

' -- Flux depuis client --
BROWSER --> NGINX  : HTTPS :443
PHONE   --> NGINX  : HTTPS :443

' -- Flux Nginx (reverse proxy) --
NGINX --> BACKEND  : /api/**
NGINX --> FRONTEND : /
NGINX --> AIRFLOW  : /airflow/**
NGINX --> ML       : /ml/**

' -- Flux internes --
BACKEND  --> PG    : JDBC :5432
BACKEND  --> REDIS : lettuce :6379
BACKEND  --> ML    : HTTP /score/*
ML       --> PG    : asyncpg :5432
AIRFLOW  --> PG    : SQLAlchemy :5432
AIRFLOW  --> DBT   : BashOperator
AIRFLOW  --> ML    : dag_ml_scoring
AIRFLOW_SCHED --> AIRFLOW

' -- Flux externes --
BACKEND --> SMTP
BACKEND --> GROQ
AIRFLOW --> MTN
AIRFLOW --> OM

@enduml
