@startuml SEQ02_calcul_par
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ02 - Calcul quotidien PAR30 / PAR90\ndbt Core 1.8 + PostgreSQL 15

actor "Airflow Scheduler" as SCHED
participant "DAG\ndag_kpis_quotidien" as DAG
participant "dbt Core 1.8\n(modeles SQL)" as DBT
database "PostgreSQL 15\nstaging" as STG
database "PostgreSQL 15\ndw" as DW
participant "dbt Tests" as TESTS

SCHED -> DAG : Trigger apres succes dag_ingestion_*\n(06h30 - ordre de dependance)
activate DAG

DAG -> DBT : dbt run --select staging.*
activate DBT

DBT -> STG : SELECT creances, echeances, collectes\n(donnees ingeres du jour)
STG --> DBT : Dataset actif

DBT -> STG : CREATE TABLE stg_clients,\nstg_collectes_terrain,\nstg_creances, stg_prix_produits
DBT --> DAG : staging termine

DAG -> DBT : dbt run --select intermediate.*\n(agregats metier)
DBT -> STG : CTE calcul joursRetard\nSELECT CURRENT_DATE - dateEcheance\nWHERE montantRestant > 0
STG --> DBT : joursRetard par creance

DBT -> DBT : Calcul PAR30 :\nSUM(encours) WHERE joursRetard > 30\n/ SUM(encours_total) par agence

DBT -> DBT : Calcul PAR90 :\nSUM(encours) WHERE joursRetard > 90\n/ SUM(encours_total) par agence

DBT -> DW : INSERT INTO dw.mart_kpi_recouvrement\n(agence_id, date_snapshot, encours_par30,\ntaux_par30, encours_par90, taux_par90, ...)
DW --> DBT : {rows_inserted: Z}

deactivate DBT

DAG -> TESTS : dbt test --select mart.*
activate TESTS
TESTS -> DW : Verifier not_null(agence_id, encours_total)
TESTS -> DW : Verifier taux_par30 BETWEEN 0 AND 1
TESTS -> DW : Verifier taux_par90 <= taux_par30
DW --> TESTS : tests results
TESTS --> DAG : {passed: N, failed: 0}
deactivate TESTS

DAG -> DBT : dbt run --select mart.mart_benchmarks_agences
activate DBT
DBT -> DW : INSERT dw.mart_benchmarks_agences\n(rang_agence, score_performance, ...)
DW --> DBT : OK
deactivate DBT

DAG --> SCHED : Task dag_kpis_quotidien -> SUCCESS\n(duree ~20 min)
deactivate DAG

@enduml
