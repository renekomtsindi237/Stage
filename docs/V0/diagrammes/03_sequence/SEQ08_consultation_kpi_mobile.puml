@startuml SEQ08_consultation_kpi_mobile
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ08 - Consultation KPIs depuis Flutter\nDashboard Mobile Directeur (Provider 6.1)

actor "Directeur" as DG
participant "Flutter App\n(DashboardScreen)" as APP
participant "DashboardProvider\n(Provider 6.1)" as PROV
participant "ApiClient\n(http package)" as API_CLIENT
participant "Spring Boot API\nKpiController" as SPRING
database "PostgreSQL 15\nschema dw" as PG

== Chargement du Dashboard ==

DG -> APP : Ouvre l'application
APP -> APP : GoRouter -> /dashboard

APP -> PROV : Consumer<DashboardProvider>.build()
PROV -> PROV : Verifie cache\n(< 30 min valide)

alt Donnees expirees ou premiere ouverture

  PROV -> API_CLIENT : fetchDashboardSummary()

  API_CLIENT -> SPRING : GET /api/v1/directeur/kpis-summary\n[Cookie: imf_access]
  activate SPRING

  SPRING -> SPRING : @PreAuthorize\nhasRole('DIRECTEUR')

  SPRING -> PG : SELECT FROM dw.mart_kpi_recouvrement\nWHERE date_snapshot = CURRENT_DATE - 1\nJOIN dw.mart_kpi_collecte ...
  note right : Donnees dbt\nreponse < 100ms

  PG --> SPRING : ResultSet agence agence

  SPRING -> PG : SELECT serie PAR30\n(30 derniers jours)\npour graphique tendance
  PG --> SPRING : [{dateSnapshot, tauxPar30}, ...]

  SPRING --> API_CLIENT : 200 OK\n{totalCollectes, par30, par90,\nnbAlertes, trendPar30: [...]}
  deactivate SPRING

  PROV -> PROV : Stocke en cache\n(timestamp = NOW())
  PROV --> APP : DashboardState.loaded(data)

else Donnees en cache valides
  PROV --> APP : DashboardState.loaded(cachedData)
end

APP -> APP : Render widgets\n- KpiCard PAR30\n- KpiCard PAR90\n- KpiCard Collectes (XAF)\n- KpiCard Alertes actives\n- LineChart tendance PAR30

APP --> DG : Dashboard affiche (< 2 secondes)

== Pull to Refresh ==

DG -> APP : Swipe down
APP -> PROV : notifyListeners() - invalide cache
PROV -> API_CLIENT : fetchDashboardSummary()
note right : Meme sequence que ci-dessus

== Navigation alertes ==

DG -> APP : Tape sur KpiCard "Alertes"
APP -> APP : GoRouter.go() /alertes

APP -> API_CLIENT : GET /api/v1/alertes?statut=ACTIVE
API_CLIENT -> SPRING : HTTP GET [Cookie: imf_access]
SPRING -> PG : SELECT alertes_impayes\nWHERE statut = ACTIVE\nORDER BY joursRetard DESC
PG --> SPRING : [{alertes}]
SPRING --> APP : 200 OK [AlerteResponse]

APP --> DG : Liste alertes triees\npar gravite (joursRetard DESC)

@enduml
