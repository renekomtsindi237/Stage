@startuml SEQ07_push_notification
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ07 - Notifications push FCM vers Flutter\nCycle complet : Alerte -> FCM -> App Mobile

participant "dag_alertes_impayes\n(Airflow)" as DAG
participant "Spring Boot\nNotificationService" as SPRING
participant "Firebase Admin SDK\n(Java)" as FB_ADMIN
participant "Firebase FCM\n(Google Cloud)" as FCM
participant "Flutter App\n(Android/iOS)" as APP
actor "Directeur" as DIR
database "PostgreSQL 15" as PG

== Declenchement depuis le pipeline ==

DAG -> SPRING : POST /internal/trigger-alertes\n{alertes: [{uid, clientId, joursRetard}, ...]}
note right : Endpoint interne\nnon expose a l'exterieur\n(Spring Security - IP whitelist)

activate SPRING

SPRING -> PG : SELECT users.fcmToken\nWHERE role = DIRECTEUR\nAND actif = TRUE
PG --> SPRING : [{uid, fcmToken: "dXXX..."}]

SPRING -> SPRING : construire Message FCM\nTitle: "ALERTE IMPAYE"\nBody: "{client} - {jours}j de retard"\nData: {type: "ALERTE", alerteId, joursRetard}

SPRING -> FB_ADMIN : FirebaseMessaging.send(message)
activate FB_ADMIN

FB_ADMIN -> FCM : HTTPS POST\nfcm.googleapis.com/v1/projects/{id}/messages:send\n{Authorization: Bearer <service_account_token>}
activate FCM

FCM --> FB_ADMIN : 200 OK {message_id: "projects/xxx/messages/yyy"}
deactivate FCM

FB_ADMIN --> SPRING : message_id
deactivate FB_ADMIN

SPRING -> PG : UPDATE alertes\nSET fcmSent=TRUE, fcmMessageId=?\nWHERE uid = ?

SPRING --> DAG : 200 OK {sent: N}
deactivate SPRING

== Reception sur l'appareil Flutter ==

FCM -> APP : Push notification livree

alt App en premier plan (foreground)
  APP -> APP : FirebaseMessaging.onMessage\nAffiche snackbar in-app
  APP --> DIR : Notification visible dans l'app

else App en arriere-plan (background)
  APP -> APP : FirebaseMessaging.onBackgroundMessage\nNotification dans barre de statut
  APP --> DIR : Notification barre de statut

else App fermee (terminated)
  FCM -> APP : Notification systeme Android/iOS
  APP --> DIR : Notification barre de statut

end

== Interaction utilisateur ==

DIR -> APP : Tape sur la notification
APP -> APP : FirebaseMessaging.onMessageOpenedApp\nExtrait alerteId depuis data payload

APP -> APP : GoRouter.go() /alertes/{alerteId}

APP -> SPRING : GET /api/v1/alertes/{uid}\n[Cookie: imf_access]
SPRING -> PG : SELECT alertes_impayes WHERE uid = ?
PG --> SPRING : alerte detail
SPRING --> APP : 200 OK AlerteResponse

APP --> DIR : Ecran detail alerte\n(client, jours, montant,\nactions : Cloturer / Escalader)

@enduml
