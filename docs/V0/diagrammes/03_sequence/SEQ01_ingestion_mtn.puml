@startuml SEQ01_ingestion_mtn
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ01 - Ingestion quotidienne transactions MTN Mobile Money\nApache Airflow 2.8.4 - dag_ingestion_mtn

actor "Airflow Scheduler" as SCHED
participant "DAG\ndag_ingestion_mtn" as DAG
participant "IngestScript\n(Python)" as SCRIPT
participant "MTN MoMo API\n(externe)" as API_MTN
database "PostgreSQL 15\nschema raw" as RAW
participant "PipelineLogger" as LOG

SCHED -> DAG : Trigger cron 0 6 * * *\n(06h00 chaque matin)
activate DAG

DAG -> SCRIPT : Execute Task: load_mtn_transactions
activate SCRIPT

SCRIPT -> API_MTN : GET /transactions?date={YYYY-MM-DD}\nAPI Key Bearer
API_MTN --> SCRIPT : [{ref, montant, date, expediteur, ...}]\n(JSON - N transactions)

SCRIPT -> SCRIPT : normalize_columns()\nRenommage colonnes -> format standard

SCRIPT -> SCRIPT : cast_types()\ndate_transaction -> TIMESTAMP\nmontant -> DECIMAL(15,2)

SCRIPT -> SCRIPT : compute_dedup_uuid()\nUUID base sur (ref_ext + date + montant + operateur)

SCRIPT -> SCRIPT : drop_duplicates()\nDeduplication intra-appel

SCRIPT -> RAW : INSERT INTO raw.transactions_mtn\nON CONFLICT (hash_dedup) DO NOTHING
note right : Deduplication inter-appels\ngestion par contrainte UNIQUE

RAW --> SCRIPT : {inserted: N, skipped: M}

SCRIPT -> LOG : log_ingestion()\nsource='MTN', inserted=N,\nduplicates=M, errors=0
activate LOG
LOG -> RAW : INSERT INTO raw.pipeline_log
deactivate LOG

SCRIPT --> DAG : {total_inserted: N, total_duplicates: M, status: SUCCESS}
deactivate SCRIPT

DAG --> SCHED : Task dag_ingestion_mtn -> SUCCESS
deactivate DAG

@enduml
