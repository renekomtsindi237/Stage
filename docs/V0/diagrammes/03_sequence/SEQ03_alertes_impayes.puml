@startuml SEQ03_alertes_impayes
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ03 - Generation automatique des alertes impayes\nAirflow + Spring Boot + SSE + FCM + SMTP

actor "Airflow Scheduler" as SCHED
participant "DAG\ndag_alertes_impayes" as DAG
participant "AlerteScript\n(Python)" as SCRIPT
database "PostgreSQL 15\ndw + app" as PG
participant "Spring Boot API\nSseController" as SPRING
participant "Firebase FCM" as FCM
participant "Serveur SMTP" as SMTP
actor "Directeur" as DIR

SCHED -> DAG : Trigger apres succes dag_kpis_quotidien\n(08h00 - dependance Airflow)
activate DAG

DAG -> SCRIPT : Execute Task: detect_impayes
activate SCRIPT

SCRIPT -> PG : SELECT creances WHERE\njoursRetard > 30\nAND statut IN (EN_RETARD, EN_RECOUVREMENT)
PG --> SCRIPT : [{uid, clientId, montantEnRetard, joursRetard}, ...]

loop Pour chaque creance en retard

  SCRIPT -> PG : SELECT alerte ACTIVE\nexistante pour cette creance
  PG --> SCRIPT : existe ?

  alt Nouvelle alerte (premiere detection)
    SCRIPT -> PG : INSERT app.alertes_impayes\n{uid, clientId, joursRetard,\nmontant, statutAlerte=ACTIVE}
    PG --> SCRIPT : uid alerte cree

    SCRIPT -> SPRING : POST /internal/notify-alerte\n{alerteId, clientId}
    activate SPRING
    SPRING -> PG : SELECT users WHERE\nrole = DIRECTEUR AND actif = TRUE

    fork
      SPRING -> SPRING : SseController - emit event\n/api/v1/sse/stream (web temps reel)
      SPRING --> DIR : Notification SSE recue (Angular)
    fork again
      SPRING -> SMTP : sendMail()\nTo: directeur@imf.cm\nSujet: ALERTE - Creance {uid}
      SMTP --> DIR : Email recu
    fork again
      SPRING -> FCM : FirebaseMessaging.send()\n{title: "ALERTE IMPAYE",\nbody: "{client} - {jours}j de retard"}
      FCM --> DIR : Push notification mobile recue
    end fork

    SPRING -> PG : UPDATE alertes\nSET notifSseSent=TRUE,\nnotifEmailSent=TRUE\nWHERE uid = ?
    deactivate SPRING

  else Alerte deja existante (mise a jour)
    SCRIPT -> PG : UPDATE alertes_impayes\nSET joursRetard = joursRetard + 1\nWHERE uid = ?
  end

end

SCRIPT -> PG : UPDATE alertes SET statut=CLOTUREE\nWHERE clientId IN (creances soldees)
note right : Cloture automatique\nalertes resolues

SCRIPT --> DAG : {nouvelles: N, mises_a_jour: M, cloturees: K}
deactivate SCRIPT

DAG --> SCHED : Task dag_alertes_impayes -> SUCCESS
deactivate DAG

@enduml
