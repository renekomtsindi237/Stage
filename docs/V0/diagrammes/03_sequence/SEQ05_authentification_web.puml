@startuml SEQ05_authentification_web
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ05 - Authentification web (email + OTP)\nAngular 17 -> Spring Boot 3.3 - Cookies HttpOnly

actor "Utilisateur" as USER
participant "Angular\n(LoginComponent\n+ OtpComponent)" as ANG
participant "AuthService" as AUTHSVC
participant "HttpInterceptor" as INTER
participant "Spring Boot\nAuthController" as API
database "PostgreSQL 15\n(users, otp_codes)" as PG
participant "SMTP" as SMTP

== Etape 1 - Demande de code OTP ==

USER -> ANG : Saisit son email (/login)
ANG -> AUTHSVC : requestOtp(email)
AUTHSVC -> API : POST /auth/request-otp?email={email}
activate API
API -> PG : SELECT users WHERE email = ?
PG --> API : {uid, role, actif}
alt Utilisateur actif
  API -> PG : INSERT otp_codes {userId, codeHash, expiresAt}
  API -> SMTP : Envoie code OTP (valable 10 min)
  API --> AUTHSVC : 200 OK {status: "OTP_SENT"}
  deactivate API
  ANG --> USER : Redirige vers /otp
else Email inconnu
  API --> AUTHSVC : 200 OK (reponse identique - anti-enumeration)
end

== Etape 2 - Verification du code ==

USER -> ANG : Saisit les 6 chiffres (autosoumission)
ANG -> AUTHSVC : verifyOtp(email, code)
AUTHSVC -> API : POST /auth/verify-otp {email, code}
activate API
API -> PG : SELECT otp_codes WHERE userId = ?\nAND expiresAt > NOW()
PG --> API : {codeHash, tentatives}
API -> API : BCrypt.matches(code, codeHash)

alt Code valide (tentatives < 3)
  API -> PG : INSERT refresh_tokens {userId, tokenHash, expiresAt}
  API -> PG : DELETE otp_codes WHERE userId = ?
  API --> AUTHSVC : 200 OK {role, nomComplet}\n+ Set-Cookie: imf_access=...; HttpOnly; Secure\n+ Set-Cookie: imf_refresh=...; HttpOnly; Secure
  deactivate API
  AUTHSVC -> AUTHSVC : Stocke role + nomComplet (signal Angular)
  ANG --> USER : Redirection selon role (defaultRouteForRole)
else Code invalide ou expire
  API --> AUTHSVC : 401 Unauthorized
  ANG --> USER : Affiche erreur - reset formulaire
else 3 tentatives epuisees
  API --> AUTHSVC : 401 {message: "Code verrouille"}
  ANG --> USER : Demandez un nouveau code
end

== Requete API protegee ==

USER -> ANG : Navigue vers une page protegee
note over INTER
  Cookie imf_access envoye automatiquement
  par le navigateur (pas d'injection manuelle)
end note
INTER -> API : GET /api/v1/directeur/kpis [Cookie: imf_access]
API --> ANG : 200 OK

== Rafraichissement du token ==

INTER -> API : GET /api/v1/... [Cookie: imf_access expire]
API --> INTER : 401 Unauthorized
INTER -> API : POST /auth/refresh [Cookie: imf_refresh]
activate API
API -> PG : SELECT refresh_tokens WHERE hash = ? AND expiresAt > NOW()
PG --> API : valide
API --> INTER : 200 OK + Set-Cookie: imf_access=...; HttpOnly
deactivate API
INTER -> API : Rejoue la requete initiale
API --> ANG : 200 OK

== Deconnexion ==

USER -> ANG : Clic "Se deconnecter"
ANG -> API : POST /auth/logout [Cookie: imf_refresh]
API -> PG : DELETE refresh_tokens WHERE hash = ?
API --> ANG : 200 OK + Set-Cookie: imf_access=; Max-Age=0\n+ Set-Cookie: imf_refresh=; Max-Age=0
ANG --> USER : Redirige vers /login

@enduml
