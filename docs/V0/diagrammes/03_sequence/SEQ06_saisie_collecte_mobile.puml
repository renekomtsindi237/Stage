@startuml SEQ06_saisie_collecte_mobile
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ06 - Saisie collecte mobile (offline-first)

actor "Agent Terrain" as AGENT
participant "Flutter App\n(CollecteFeature)" as APP
participant "CollecteProvider\n(Provider 6.1)" as PROV
database "SQLite local\n(sqflite)" as LOCAL
participant "Spring Boot API\n/api/v1 - :8080" as API
database "PostgreSQL 15\n(app.collectes_terrain)" as PG

== Saisie ==

AGENT -> APP : Ouvre "Nouvelle collecte"
APP -> LOCAL : SELECT clients WHERE agentId = {uid}
LOCAL --> APP : liste clients locaux

AGENT -> APP : clientId, montant, canal,\nref. transaction, observation
APP -> PROV : soumettre(form)
PROV -> PROV : validate()\nGenere uid = UUID.v4()

== Mode connecte ==

alt Reseau disponible

  PROV -> API : POST /api/v1/collectes\n{uid, clientId, agentId, montant, canal}
  activate API
  API -> API : JwtFilter - valide cookie imf_access\nverifie role AGENT_TERRAIN
  API -> PG : SELECT uid FROM collectes_terrain WHERE uid = ?\n(deduplication)
  PG --> API : absent
  API -> PG : INSERT collectes_terrain {uid, ..., statut=SOUMISE}
  PG --> API : OK
  API --> PROV : 201 Created {uid, statut: "SOUMISE"}
  deactivate API
  PROV -> LOCAL : INSERT {uid, statut=CONFIRMEE}
  PROV --> APP : success
  APP --> AGENT : Collecte enregistree - uid: {uid}

else Hors ligne

  PROV -> LOCAL : INSERT {uid, statut=PENDING_SYNC}
  PROV --> APP : saved_offline
  APP --> AGENT : Sauvegarde hors ligne

  note over AGENT, LOCAL
    Plusieurs collectes peuvent etre
    saisies hors ligne. Chaque collecte
    possede un UUID unique.
  end note

  == Retour de connectivite ==

  PROV -> PROV : ConnectivityPlus detecte reseau
  PROV -> LOCAL : SELECT * FROM collectes\nWHERE statut = PENDING_SYNC
  LOCAL --> PROV : [collecte_1, collecte_2, ...]

  loop Pour chaque collecte en attente
    PROV -> API : POST /api/v1/collectes {collecte}
    activate API
    alt 201 Created
      API --> PROV : 201
      PROV -> LOCAL : UPDATE statut = CONFIRMEE
    else 409 Conflict (doublon UUID)
      API --> PROV : 409
      PROV -> LOCAL : UPDATE statut = DOUBLON
    else 5xx Erreur serveur
      API --> PROV : 500
      PROV -> LOCAL : retryCount += 1
    end
    deactivate API
  end

  APP --> AGENT : N collecte(s) synchronisee(s)

end

@enduml
