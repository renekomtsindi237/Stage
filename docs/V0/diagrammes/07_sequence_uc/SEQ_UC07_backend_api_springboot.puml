@startuml SEQ_UC07_backend_api_springboot
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC07 - Backend API Spring Boot 3.3 / Java 21\nAuth OTP - RBAC - KPIs - Collectes - SSE - Chatbot IA

actor "Client Angular\n(navigateur)" as ANG
actor "Client Flutter\n(mobile)" as FLT
actor "Airflow DAG\n(interne)" as AIRFLOW

box "nginx :80"
  participant "Nginx\n(Reverse Proxy)" as NGINX
end box

box "springboot-api :8080"
  participant "JwtAuthFilter\n(OncePerRequestFilter)" as JWT_FILTER
  participant "AuthController\n/auth/**" as CTRL_AUTH
  participant "DirecteurController\n/api/v1/directeur/**" as CTRL_DIR
  participant "CollecteController\n/api/v1/collectes" as CTRL_COL
  participant "AlerteController\n/api/v1/alertes/**" as CTRL_ALE
  participant "SseController\n/api/v1/sse/stream" as CTRL_SSE
  participant "AiChatController\n/api/v1/ai/chat" as CTRL_AI
  participant "JwtTokenProvider" as JWT_SVC
end box

database "PostgreSQL 15\n(app + dw + ml)" as PG
participant "GROQ API\n(LLM)" as GROQ

== Auth OTP - Etape 1 ==

ANG -> NGINX : POST /auth/request-otp?email={email}
NGINX -> CTRL_AUTH : Proxy
CTRL_AUTH -> PG : SELECT users WHERE email = ?
PG --> CTRL_AUTH : {uid, role, actif}
CTRL_AUTH -> PG : INSERT otp_codes {userId, codeHash, expiresAt}
CTRL_AUTH -> CTRL_AUTH : SMTP send OTP
CTRL_AUTH --> ANG : 200 OK {status: OTP_SENT}

== Auth OTP - Etape 2 ==

ANG -> NGINX : POST /auth/verify-otp {email, code}
NGINX -> CTRL_AUTH : Proxy
CTRL_AUTH -> PG : SELECT otp_codes WHERE userId AND expiresAt > NOW()
CTRL_AUTH -> CTRL_AUTH : BCrypt.matches(code, codeHash)
CTRL_AUTH -> JWT_SVC : generateAccessToken(user)
JWT_SVC --> CTRL_AUTH : imf_access (HS256, 15min)
CTRL_AUTH -> JWT_SVC : generateRefreshToken()
JWT_SVC --> CTRL_AUTH : imf_refresh (7j)
CTRL_AUTH --> ANG : 200 OK {role, nomComplet}\n+ Set-Cookie: imf_access=...; HttpOnly; Secure\n+ Set-Cookie: imf_refresh=...; HttpOnly; Secure

== Requete KPIs protegee ==

ANG -> NGINX : GET /api/v1/directeur/kpis [Cookie: imf_access]
NGINX -> JWT_FILTER : Extrait cookie imf_access
JWT_FILTER -> JWT_SVC : validateToken(token)
JWT_SVC --> JWT_FILTER : userId, role=DIRECTEUR
JWT_FILTER -> CTRL_DIR : Route (role DIRECTEUR autorise)
CTRL_DIR -> PG : SELECT FROM dw.mart_kpi_recouvrement\nJOIN dw.mart_kpi_collecte WHERE ?
PG --> CTRL_DIR : KPIs
CTRL_DIR --> ANG : 200 OK KpiResponse

== Enregistrement collecte ==

FLT -> NGINX : POST /api/v1/collectes {uid, clientId, montant, canal}\n[Cookie: imf_access]
NGINX -> JWT_FILTER : Extrait cookie, valide AGENT_TERRAIN
JWT_FILTER -> CTRL_COL : Route autorisee
CTRL_COL -> PG : SELECT uid FROM collectes_terrain WHERE uid=? (dedup)
PG --> CTRL_COL : absent
CTRL_COL -> PG : INSERT app.collectes_terrain {uid, statut=SOUMISE}
CTRL_COL --> FLT : 201 Created {uid, statut: SOUMISE}

== SSE temps reel ==

ANG -> NGINX : GET /api/v1/sse/stream [Cookie: imf_access]
NGINX -> CTRL_SSE : Proxy (long-lived connection)
CTRL_SSE -> CTRL_SSE : SseEmitter.subscribe(userId)
note right : Connexion maintenue\n(HTTP/1.1 keep-alive)

AIRFLOW -> CTRL_ALE : POST /internal/notify-alerte {alerteId}
CTRL_ALE -> CTRL_SSE : broadcastToRole(DIRECTEUR, event)
CTRL_SSE --> ANG : data: {type: ALERTE, alerteId, message}\n(SSE event)
ANG --> ANG : NotifPanel.update() - badge increment

== Chatbot IA ==

ANG -> NGINX : POST /api/v1/ai/chat {message: "Explique PAR30"}
NGINX -> CTRL_AI : Proxy
CTRL_AI -> GROQ : POST completions\n{model: "llama-3.*", messages: [...]}
GROQ --> CTRL_AI : {choices: [{message: {content: "..."}}]}
CTRL_AI --> ANG : 200 OK {response: "..."}

@enduml
