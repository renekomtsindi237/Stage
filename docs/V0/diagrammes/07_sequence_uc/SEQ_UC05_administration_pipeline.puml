@startuml SEQ_UC05_administration_pipeline
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC05 - Administration du Pipeline (DSI)\nSurveillance - Declenchement - Backfill - Configuration

actor "DSI" as DSI

box "nginx :80"
  participant "Nginx\n(Proxy /airflow/*)" as NGINX
end box

box "airflow-webserver :8089"
  participant "Airflow Web UI\n(REST API interne)" as AWU
end box

box "airflow-scheduler"
  participant "Airflow Scheduler\n(DagBag - heartbeat 5s)" as AS
  participant "DAGs disponibles\n(14 DAGs)" as DAGS
end box

box "postgres:15 (Airflow DB)"
  database "dag_run\ntask_instance\nlog" as AIRFLOW_DB
end box

box "springboot-api :8080"
  participant "DsiController\nAdminController" as SPRING
end box

== Surveillance etat des DAGs ==

DSI -> NGINX : HTTPS GET /airflow/dags
NGINX -> AWU : Proxy /airflow/dags
AWU -> AIRFLOW_DB : SELECT dag_run WHERE\nexecution_date > NOW() - INTERVAL '7 days'
AIRFLOW_DB --> AWU : [{dag_id, state, start_date, duration}]
AWU --> DSI : Liste DAGs avec statuts\n(success/failed/running)

== Declenchement manuel ==

DSI -> AWU : POST /api/v2/dags/{dag_id}/dagRuns\n{logical_date: "2026-06-29T06:00:00"}
AWU -> AS : Trigger dag_id sur la date
AS -> DAGS : Enqueue toutes les tasks
DAGS --> AS : tasks in queue
AWU --> DSI : 200 OK {dag_run_id, state: "queued"}

loop Polling etat du DAG

  DSI -> AWU : GET /api/v2/dags/{dag_id}/dagRuns/{run_id}
  AWU -> AIRFLOW_DB : SELECT state FROM dag_run
  AIRFLOW_DB --> AWU : {state: "running" | "success" | "failed"}
  AWU --> DSI : Etat actuel

end

== Consultation logs ==

DSI -> AWU : GET /api/v2/dags/{dag_id}/dagRuns/{run_id}/taskInstances
AWU -> AIRFLOW_DB : SELECT task_instances + logs
AIRFLOW_DB --> AWU : [{task_id, state, log_url}]
AWU --> DSI : Liste task instances

== Gestion utilisateurs ==

DSI -> SPRING : GET /api/v1/dsi/users\n[Cookie: imf_access]
SPRING -> SPRING : @PreAuthorize role=DSI
SPRING -> SPRING : SELECT users WHERE imf_id = ?
SPRING --> DSI : 200 OK [UserResponse]

DSI -> SPRING : POST /api/v1/admin/users\n{email, nomComplet, role, agenceId}\n[Cookie: imf_access]
SPRING -> SPRING : INSERT app.users\nSEND email invitation (SMTP)
SPRING --> DSI : 201 Created UserResponse

@enduml
