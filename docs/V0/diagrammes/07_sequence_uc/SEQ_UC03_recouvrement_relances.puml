@startuml SEQ_UC03_recouvrement_relances
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC03 - Recouvrement et Relances\nDetection auto -> Alertes multi-canaux -> Gestion Angular + Flutter

actor "Directeur\n(web Angular)" as DIR
actor "Agent Terrain\n(Flutter)" as AT

box "airflow-scheduler"
  participant "dag_alertes_impayes\n(cron: 0 8 * * *)" as DAG_ALERT
end box

box "postgres:15 (app + dw)"
  database "app.creances\napp.alertes_impayes" as PG_APP
  database "dw.mart_kpi_recouvrement" as PG_DW
end box

box "springboot-api :8080"
  participant "SseController\nAlertesController" as SPRING
end box

participant "SMTP" as SMTP
participant "Firebase FCM" as FCM

== Detection et creation des alertes ==

DAG_ALERT -> PG_DW : SELECT agence_id, taux_par30, taux_par90\nWHERE date_snapshot = CURRENT_DATE
PG_DW --> DAG_ALERT : KPIs jour

DAG_ALERT -> PG_APP : SELECT creances WHERE\njours_retard > 30\nAND statut IN (EN_RETARD, EN_RECOUVREMENT)
PG_APP --> DAG_ALERT : [{uid, clientId, joursRetard, montant}]

loop Pour chaque creance en retard

  DAG_ALERT -> PG_APP : SELECT COUNT(*) FROM alertes_impayes\nWHERE creance_id=? AND statut_alerte=ACTIVE
  PG_APP --> DAG_ALERT : 0 (premiere detection)

  DAG_ALERT -> PG_APP : INSERT alertes_impayes\n{uid, creanceId, joursRetard, montant,\nstatutAlerte=ACTIVE, typeAlerte=?}
  DAG_ALERT -> SPRING : POST /internal/notify-alerte {alerteId}

  SPRING -> PG_APP : SELECT users WHERE\nrole = DIRECTEUR AND actif = TRUE

  fork
    SPRING -> SPRING : SseEmitter.send(event)\n/api/v1/sse/stream
    SPRING --> DIR : Notification SSE\n(Angular NotifPanel)
  fork again
    SPRING -> SMTP : sendMail()\nAlerte impayee client {nom}
    SMTP --> DIR : Email recu
  fork again
    SPRING -> FCM : FirebaseMessaging.send()\nMessage push FCM
    FCM --> AT : Push notification mobile
    FCM --> DIR : Push notification mobile
  end fork

end

== Consultation et gestion des alertes ==

DIR -> SPRING : GET /api/v1/alertes?statut=ACTIVE\n[Cookie: imf_access]
SPRING -> PG_APP : SELECT alertes_impayes\nWHERE statut_alerte = ACTIVE\nORDER BY jours_retard DESC
PG_APP --> SPRING : [{alertes}]
SPRING --> DIR : 200 OK [AlerteResponse]

DIR -> SPRING : PUT /api/v1/alertes/{uid}/statut\n{statut: "CLOTUREE"}\n[Cookie: imf_access]
SPRING -> PG_APP : UPDATE alertes_impayes\nSET statut_alerte = CLOTUREE\nSET date_cloture = NOW()
PG_APP --> SPRING : OK
SPRING --> DIR : 200 OK {statut: "CLOTUREE"}

== Escalade ==

DIR -> SPRING : PUT /api/v1/alertes/{uid}/statut\n{statut: "ESCALADEE"}\n[Cookie: imf_access]
SPRING -> PG_APP : UPDATE alertes SET statut_alerte = ESCALADEE
SPRING -> SPRING : SseEmitter.send(prioritaire)\nau Directeur
SPRING --> DIR : 200 OK {statut: "ESCALADEE"}

@enduml
