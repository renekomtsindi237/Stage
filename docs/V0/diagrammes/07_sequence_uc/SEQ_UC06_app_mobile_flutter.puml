@startuml SEQ_UC06_app_mobile_flutter
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC06 - Application Mobile Flutter 3.24\nAgent (collectes offline) + Directeur (KPIs) + FCM

actor "Agent Terrain\n(AGENT_TERRAIN)" as AT
actor "Directeur\n(DIRECTEUR)" as DIR

box "Flutter App (Android/iOS) - Provider 6.1"
  participant "GoRouter\n(AuthGuard + RoleGuard)" as ROUTER
  participant "AuthProvider\n(ChangeNotifier)" as AUTH_PROV
  participant "CollecteProvider\n(ChangeNotifier)" as COL_PROV
  participant "DashboardProvider\n(ChangeNotifier)" as DASH_PROV
  participant "SyncService" as SYNC
  participant "LocalDatabase\n(sqflite - SQLite)" as LOCAL_DB
  participant "ApiClient\n(http package)" as API
  participant "FcmService\n(firebase_messaging)" as FCM_SVC
end box

box "nginx :80"
  participant "Nginx\n(Proxy /api/*)" as NGINX
end box

box "springboot-api :8080"
  participant "AuthController\nCollecteController\nKpiController" as SPRING
end box

== Authentification email + OTP ==

AT -> AUTH_PROV : requestOtp(email)
AUTH_PROV -> API : POST /auth/request-otp?email={email}
API -> NGINX : Proxy
NGINX -> SPRING : POST /auth/request-otp
SPRING --> API : 200 OK {status: OTP_SENT}
AUTH_PROV --> AT : Affiche ecran OTP

AT -> AUTH_PROV : verifyOtp(email, code6chiffres)
AUTH_PROV -> API : POST /auth/verify-otp {email, code}
NGINX -> SPRING : POST /auth/verify-otp
SPRING --> API : 200 OK {role, nomComplet}\n+ Set-Cookie: imf_access; imf_refresh\n(HttpOnly; Secure)
AUTH_PROV -> LOCAL_DB : Stocke role + nomComplet
ROUTER -> ROUTER : Redirige vers /dashboard (role)

== Saisie collecte offline-first ==

AT -> COL_PROV : soumettre(collecte)\n{uid=UUID.v4(), clientId, montant, canal}

alt Connexion disponible
  COL_PROV -> API : POST /api/v1/collectes {uid, ...}\n[Cookie: imf_access auto]
  NGINX -> SPRING : Proxy
  SPRING --> API : 201 Created {uid, statut: SOUMISE}
  COL_PROV -> LOCAL_DB : INSERT {uid, statut: CONFIRMEE}
  COL_PROV --> AT : Collecte enregistree

else Hors ligne
  COL_PROV -> LOCAL_DB : INSERT {uid, statut: PENDING_SYNC}
  COL_PROV --> AT : Sauvegarde locale

  SYNC -> SYNC : ConnectivityPlus detecte reseau
  SYNC -> LOCAL_DB : SELECT WHERE statut = PENDING_SYNC
  LOCAL_DB --> SYNC : [collectes en attente]
  loop Chaque collecte
    SYNC -> API : POST /api/v1/collectes {collecte}
    API --> SYNC : 201 / 409 / 5xx
    SYNC -> LOCAL_DB : UPDATE statut (CONFIRMEE/DOUBLON/SYNC_ERROR)
  end
  COL_PROV --> AT : N collecte(s) synchronisee(s)
end

== Dashboard mobile Directeur ==

DIR -> DASH_PROV : fetch()
DASH_PROV -> API : GET /api/v1/directeur/kpis-summary\n[Cookie: imf_access auto]
NGINX -> SPRING : Proxy
SPRING --> API : 200 OK {par30, par90, totalCollectes, nbAlertes}
DASH_PROV --> DIR : Dashboard KPIs affiches

== Notification push FCM ==

FCM_SVC -> FCM_SVC : FirebaseMessaging.onMessage\n(alerte impayee)
FCM_SVC --> DIR : Snackbar in-app

DIR -> ROUTER : GoRouter.go('/alertes/{alerteId}')
API -> SPRING : GET /api/v1/alertes/{uid}
SPRING --> DIR : Detail alerte

@enduml
