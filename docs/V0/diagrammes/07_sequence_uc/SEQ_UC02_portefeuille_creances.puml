@startuml SEQ_UC02_portefeuille_creances
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC02 - Suivi Portefeuille de Creances (PAR30/PAR90)\nCBS -> Airflow -> dbt -> Spring Boot -> Angular + Flutter

actor "Directeur\n(web Angular)" as DIR
actor "Analyste Credit\n(web Angular)" as ANA

boundary "Core Banking System" as CBS

box "airflow-scheduler"
  participant "dag_ingestion_cbs\ndag_kpis_quotidien" as DAGS
end box

box "dbt Core 1.8"
  participant "stg_creances\nint_* agregats" as DBT_STG
  participant "mart_kpi_recouvrement" as DBT_MART
end box

box "postgres:15"
  database "schema raw" as RAW
  database "schema dw" as DW
  database "schema ml" as ML
end box

box "springboot-api :8080"
  participant "DirecteurController\nAnalysteController" as SPRING
end box

box "ml-api :8090"
  participant "MCRSScorer\nFastAPI" as ML_API
end box

== Ingestion CBS et calcul PAR ==

DAGS -> CBS : GET /prets + /creances\n(quotidien 06h00)
CBS --> DAGS : [{pretsActifs, joursRetard, montants}]
DAGS -> RAW : INSERT raw.creances, raw.prets

DAGS -> DBT_STG : dbt run --select staging.*\nintermediate.*
DBT_STG -> RAW : SELECT * FROM raw.creances\nJOIN raw.prets
RAW --> DBT_STG : donnees brutes
DBT_STG -> DW : CREATE stg_creances, int_par_agences

DAGS -> DBT_MART : dbt run --select mart.mart_kpi_recouvrement
DBT_MART -> DW : SELECT int_par_agences\nGROUP BY agence, date
DW --> DBT_MART : agregats PAR
DBT_MART -> DW : INSERT mart_kpi_recouvrement\n{agence_id, taux_par30, taux_par90,\nencours_par30, encours_par90, ...}

== Scoring ML des clients ==

DAGS -> ML_API : POST /score/batch\n{clientIds: [...]}
ML_API -> ML : SELECT ml.features_client\nWHERE date = CURRENT_DATE - 1
ML --> ML_API : features
ML_API -> ML_API : CRSCalc + RPSCalc + CSICalc\n-> MCRS = 0.35×(1-CRS) + 0.45×RPS + 0.20×CSI
ML_API -> ML : INSERT ml.client_scores\n{uid, clientId, scoreMcrs, niveauRisque}

== Consultation par le Directeur ==

DIR -> SPRING : GET /api/v1/directeur/kpis\n?dateDebut=...&agenceId=...\n[Cookie: imf_access]
SPRING -> DW : SELECT FROM dw.mart_kpi_recouvrement\nWHERE date_snapshot BETWEEN ? AND ?
DW --> SPRING : KPIs PAR
SPRING --> DIR : 200 OK {par30, par90, encours, trendPar30}

== Consultation scoring par l'Analyste ==

ANA -> SPRING : GET /api/v1/analyste/scoring/{clientId}\n[Cookie: imf_access]
SPRING -> ML : SELECT ml.client_scores\nWHERE clientId = ?
ML --> SPRING : {scoreMcrs, scoreCrs, niveauRisque}
SPRING -> ML : SELECT ml.shap_explanations\nWHERE scoreId = ?
ML --> SPRING : [{featureName, shapValue, rang}]
SPRING --> ANA : 200 OK ScoringResponse

@enduml
