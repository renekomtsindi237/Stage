@startuml SEQ_UC01_collectes_digitales
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #888888
  ParticipantBackgroundColor white
  ParticipantBorderColor #666666
  ActorBackgroundColor white
  ActorBorderColor #333333
  BoxBackgroundColor #F8F8F8
  BoxBorderColor #AAAAAA
  NoteBackgroundColor #FFFFEE
  NoteBorderColor #AAAAAA
}

title SEQ_UC01 - Gestion des Collectes Digitales\nSources API -> Airflow -> dbt -> Spring Boot -> Angular

actor "Analyste Credit\n(web)" as ANA
actor "Agent Terrain\n(Flutter)" as AT

boundary "MTN MoMo API" as MTN
boundary "Orange Money API" as OM
boundary "Core Banking System" as CBS

box "airflow-scheduler"
  participant "Airflow Scheduler\n(cron: 0 6 * * *)" as AS
end box

box "dags/"
  participant "dag_ingestion_mtn\ndag_ingestion_orange" as DAG_ING
  participant "dag_kpis_quotidien" as DAG_KPI
end box

box "dbt Core 1.8"
  participant "stg_collectes_terrain\nstg_creances" as DBT_STG
  participant "mart_kpi_collecte" as DBT_MART
end box

box "postgres:15 (app + dw)"
  database "schema raw" as RAW
  database "schema staging" as STG
  database "schema dw" as DW
  database "schema app" as APP
end box

box "springboot-api :8080"
  participant "CollecteController\nKpiController" as SPRING
end box

== Ingestion quotidienne ==

AS -> DAG_ING : Trigger 06h00
DAG_ING -> MTN : GET /transactions?date={today}
MTN --> DAG_ING : [{ref, montant, ...}]
DAG_ING -> OM : GET /transactions?date={today}
OM --> DAG_ING : [{ref, montant, ...}]
DAG_ING -> RAW : INSERT raw.transactions_mtn\nINSERT raw.transactions_orange\nON CONFLICT DO NOTHING

DAG_ING -> CBS : GET prets + creances
CBS --> DAG_ING : [{pretsActifs, ...}]
DAG_ING -> APP : INSERT app.collectes_terrain\n(si nouvelles collectes mobile)

== Transformation dbt ==

AS -> DBT_STG : dbt run --select staging.*
DBT_STG -> RAW : SELECT * FROM raw.*
RAW --> DBT_STG : donnees brutes
DBT_STG -> STG : CREATE TABLE stg_collectes_terrain\nstg_creances, stg_clients

AS -> DBT_MART : dbt run --select mart.mart_kpi_collecte
DBT_MART -> STG : SELECT agentId, montant, canal, date...\nGROUP BY agence, agent, date
STG --> DBT_MART : agregats
DBT_MART -> DW : INSERT dw.mart_kpi_collecte\n(incremental)

== Consultation web ==

ANA -> SPRING : GET /api/v1/analyste/collectes\n?agenceId=...&dateDebut=...\n[Cookie: imf_access]
SPRING -> DW : SELECT FROM dw.mart_kpi_collecte\nWHERE agence_id=? AND date_snapshot BETWEEN ?
DW --> SPRING : KPIs collectes
SPRING --> ANA : 200 OK KpiCollecteResponse

== Saisie mobile terrain ==

AT -> SPRING : POST /api/v1/collectes\n{uid, clientId, montant, canal}\n[Cookie: imf_access]
SPRING -> APP : INSERT app.collectes_terrain\n(uid = UUID unique)
APP --> SPRING : OK
SPRING --> AT : 201 Created {uid, statut: SOUMISE}

@enduml
