@startuml ACT02_collecte_TOBE
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT02 - Processus Collecte Digitale - Situation Cible (TO-BE)\nPipeline Automatise + Scoring ML

| Client |
| MTN / Orange Money |
| Airflow Pipeline |
| PostgreSQL |
| FastAPI ML |
| DSI |

start

|Client|
:Effectue paiement\nvia MTN / Orange Money;

|MTN / Orange Money|
:Genere releve via API\n(dag_ingestion_mtn/orange);

|Airflow Pipeline|
:Declenchement automatique\na 06h00 (cron: 0 6 * * *);
:Appel APIs MTN + Orange Money;
:Chargement dans schema raw\n(PostgreSQL 15);
note right : Tracabilite complete\nsource, timestamp, nb lignes

:Calcul UUID\npour deduplication;

|PostgreSQL|
:INSERT ON CONFLICT DO NOTHING\n(doublons ignores automatiquement);
note right : Deduplication\nauto inter-appels

|Airflow Pipeline|
:Transformation dbt Core 1.8\n(raw -> staging -> dw);

|FastAPI ML|
:Extraction features clients\n(montant, canal, historique,\nzone, regularite);
:Scoring MCRS par client\n(CRS + RPS + CSI);
note right : Score in [0.000, 1.000]\nFAIBLE/MODERE/ELEVE/CRITIQUE

if (Niveau risque ?) then (CRITIQUE >= 0.75)
  :Marquage prioritaire\n+ AlerteImpaye generee;
  |DSI|
  :Revision manuelle\nsi necessaire;
else (FAIBLE / MODERE / ELEVE)
  :Traitement automatique;
endif

|Airflow Pipeline|
:Rapprochement automatique\ntransactions / CBS (3 passes);

if (Transactions non\nreconciliees ?) then (Oui)
  :Stockage en table suspense;
  |DSI|
  :Notification email DSI;
  |Airflow Pipeline|
else (Non)
endif

:Calcul KPIs collectes\n(dag_kpis_quotidien a 06h30);

|DSI|
:Dashboards Angular disponibles\na 08h00;

stop

@enduml
