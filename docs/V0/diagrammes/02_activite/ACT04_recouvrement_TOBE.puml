@startuml ACT04_recouvrement_TOBE
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT04 - Processus Recouvrement - Situation Cible (TO-BE)\nAutomatise - Airflow + Spring Boot + SSE + FCM

| Airflow Pipeline |
| Spring Boot API |
| Notifications SSE / FCM |
| Directeur |
| Agent Terrain (Flutter) |
| Client |

start

|Airflow Pipeline|
:Declenchement dag_alertes_impayes\na 08h00 (apres transformation DW);
:Calcul PAR30 et PAR90 quotidien\n(par agence, produit, agent);
:Detection creances\nau-dela du seuil configurable;

if (Nouvelles creances\nPAR30 detectees ?) then (Oui)

  |Spring Boot API|
  :INSERT AlerteImpaye\n{uid, clientId, joursRetard, montant,\nstatut=ACTIVE};
  :Recuperer FCM tokens agents\net web sessions Directeur;

  fork
    |Notifications SSE / FCM|
    :Envoi SSE (Server-Sent Events)\nau Directeur via SseController\n/api/v1/sse/stream;
  fork again
    |Notifications SSE / FCM|
    :Envoi email SMTP\nsi configure;
  fork again
    |Notifications SSE / FCM|
    :Envoi push FCM\n(app Flutter mobile);
  end fork

  |Directeur|
  :Recoit notification SSE (web)\net push FCM (mobile);
  :Consulte dashboard\nRecouvrement (Angular web);
  :Selectionne client en retard;

  |Agent Terrain (Flutter)|
  :Recoit notification push FCM;
  :Ouvre detail de l'alerte (Flutter);
  :Se deplace chez le client;

  |Client|
  if (Client peut payer ?) then (Oui)
    :Effectue paiement\n(MTN / Orange / especes);
    |Agent Terrain (Flutter)|
    :Saisit collecte dans Flutter\n(formulaire offline-first);
    |Spring Boot API|
    :POST /api/v1/collectes\n-> PostgreSQL app.collectes_terrain;
    :Alerte cloturee\nautomatiquement a J+1;
    |Directeur|
    :Dashboard mis a jour\n(PAR recalcule a J+1);
  else (Non)
    |Directeur|
    if (Retard > 90 jours ?) then (Oui)
      :Escalade - alerte statut = ESCALADEE;
      |Spring Boot API|
      :Notification SSE prioritaire\nau Directeur;
      :Decision plan d'apurement\nou procedure contentieuse;
    else (Non)
      :Alerte maintenue ACTIVE\n(re-notifiee le lendemain);
    endif
  endif

else (Non - aucune creance)
  :Aucune action requise;

endif

stop

@enduml
