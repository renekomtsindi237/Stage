@startuml ACT03_recouvrement_ASIS
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activity {
  BackgroundColor #FFF8E1
  BorderColor #F57F17
  FontSize 12
  DiamondBackgroundColor #FCE4EC
  DiamondBorderColor #C62828
}
skinparam ArrowColor #555555
skinparam ArrowThickness 1.5
skinparam Padding 8

title ACT03 — Processus Recouvrement\nSituation Actuelle (AS-IS)

|#FCE4EC| Responsable Recouvrement |
|#E8F5E9| Core Banking System |
|#FFF9C4| Agent de Terrain |
|#E3F2FD| Client |

start

|Responsable Recouvrement|
:<color:#C62828>Consultation manuelle du CBS\nhebdomadaire ou mensuelle</color>;
note right : <color:#C62828>PD02 — Pas de\ndétection quotidienne</color>

|Core Banking System|
:Export manuel\ndes impayés (Excel);

|Responsable Recouvrement|
:<color:#C62828>Tri et identification\nmanuelle des PAR30+</color>;
note right : <color:#C62828>PD02 — Calcul\nmanuel PAR</color>

:<color:#C62828>Appel téléphonique\nmanuel aux agents terrain</color>;
note right : <color:#C62828>PD06 — Non\ntracé</color>

|Agent de Terrain|
:Reçoit instruction\nde relancer le client;
:Contacte le client;

if (Client dispose\nde fonds ?) then (Oui)

  |Client|
  :Effectue paiement;

  |Agent de Terrain|
  :Collecte le paiement\n(espèces ou mobile);

  |Core Banking System|
  :<color:#C62828>Saisie manuelle\npar caissier (délai 1 à 3 jours)</color>;
  note right : <color:#C62828>Délai de mise\nà jour du solde</color>

  |Responsable Recouvrement|
  :<color:#C62828>Mise à jour Excel\nregistre de recouvrement</color>;

else (Non)

  |Agent de Terrain|
  :<color:#C62828>Note dans registre papier / WhatsApp\n(PD06 — Non structuré)</color>;

  |Responsable Recouvrement|
  :<color:#C62828>Analyse du délai de retard</color>;
  if (Retard > 90 jours ?) then (Oui)
    :<color:#C62828>Réunion mensuelle\npour décision write-off</color>;
  else (Non)
    :Re-planifier relance;
  endif

endif

|Responsable Recouvrement|
:<color:#C62828>Rapport mensuel\nmanuel (Word/PDF)</color>;
note right : <color:#C62828>PD05 — Données\nobsolètes, basé sur Excel</color>

stop

@enduml
