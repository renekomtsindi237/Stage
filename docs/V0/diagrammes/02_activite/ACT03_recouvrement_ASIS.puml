@startuml ACT03_recouvrement_ASIS
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT03 - Processus Recouvrement - Situation Actuelle (AS-IS)

| Responsable Recouvrement |
| Core Banking System |
| Agent de Terrain |
| Client |

start

|Responsable Recouvrement|
:Consultation manuelle du CBS\nhebdomadaire ou mensuelle;
note right : PD02 - Pas de detection quotidienne

|Core Banking System|
:Export manuel des impayes (Excel);

|Responsable Recouvrement|
:Tri et identification\nmanuelle des PAR30+;
note right : PD02 - Calcul manuel PAR

:Appel telephonique manuel\naux agents terrain;
note right : PD06 - Non trace

|Agent de Terrain|
:Recoit instruction\nde relancer le client;
:Contacte le client;

if (Client dispose de fonds ?) then (Oui)

  |Client|
  :Effectue paiement;

  |Agent de Terrain|
  :Collecte le paiement\n(especes ou mobile);

  |Core Banking System|
  :Saisie manuelle par caissier\n(delai 1 a 3 jours);
  note right : Delai de mise a jour du solde

  |Responsable Recouvrement|
  :Mise a jour Excel\nregistre de recouvrement;

else (Non)

  |Agent de Terrain|
  :Note dans registre papier\n(PD06 - non structure);

  |Responsable Recouvrement|
  :Analyse du delai de retard;
  if (Retard > 90 jours ?) then (Oui)
    :Reunion mensuelle\npour decision write-off;
  else (Non)
    :Re-planifier relance;
  endif

endif

|Responsable Recouvrement|
:Rapport mensuel manuel\n(Word/PDF);
note right : PD05 - Donnees obsoletes

stop

@enduml
