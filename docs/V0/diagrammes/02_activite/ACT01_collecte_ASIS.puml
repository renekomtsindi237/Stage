@startuml ACT01_collecte_ASIS
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT01 - Processus Collecte Digitale - Situation Actuelle (AS-IS)\nPoints douloureux identifies

| Client |
| MTN / Orange Money |
| Comptable / Agent |
| Core Banking System |

start

|Client|
:Effectue un paiement\nvia MTN ou Orange Money;

|MTN / Orange Money|
:Genere un releve CSV\n(quotidien ou hebdomadaire);
:Envoie le releve par email;

|Comptable / Agent|
:Reception manuelle de l'email\n+ telechargement;
note right : PD01 - Aucune automatisation

:Ouvre Excel et CBS en parallele;
note right : PD04 - Outils non integres

:Lecture ligne par ligne\ndu releve CSV;

:Recherche manuelle dans le CBS;

:Rapprochement manuel\n(VLOOKUP Excel ou copier-coller);
note right : PD01 - 2 a 4h/jour pour le comptable

if (Transaction identifiee\ndans le CBS ?) then (Oui)
  :Saisie manuelle du paiement\ndans le CBS;
  |Core Banking System|
  :Mise a jour du solde client\n+ registre Excel;
else (Non - non identifiee)
  :Signalement au\nresponsable d'agence;
  :Mise en attente (plusieurs jours);
  note right : PD03 - Doublon non detecte
endif

|Comptable / Agent|
:Rapport hebdomadaire\nmanuel (Word/Excel);
note right : PD05 - Donnees obsoletes

stop

@enduml
