@startuml ACT06_saisie_mobile
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT06 - Saisie Collecte Mobile (Flutter 3.24)\nMode Online et Offline-First

| Agent Terrain (Flutter) |
| SQLite local (sqflite) |
| Spring Boot API :8080 |
| PostgreSQL 15 |

start

|Agent Terrain (Flutter)|
:Ouvre formulaire\nSaisie Collecte;
:Recherche client\n(liste depuis SQLite);
:Selectionne la creance;
:Saisit montant,\ncanal, reference transaction;
:Valide le formulaire\n(controles Dart);

if (Connexion reseau\ndisponible ?) then (Oui)

  |Spring Boot API :8080|
  :POST /api/v1/collectes\n{uid, clientId, agentId,\nmontant, canal, reference}\nCookie: imf_access (HttpOnly);
  :Verification cookie\n(JwtFilter - role AGENT_TERRAIN);
  :Deduplication par uid (UUID.v4());

  if (Doublon detecte ? (409)) then (Oui)
    |Agent Terrain (Flutter)|
    :Affiche message erreur\n"Collecte deja enregistree";
    stop
  else (Non)
    |PostgreSQL 15|
    :INSERT app.collectes_terrain\n(statut = SOUMISE);

    |Spring Boot API :8080|
    :Retourne 201 Created\n{uid, statut: "SOUMISE"};

    |Agent Terrain (Flutter)|
    :Affiche confirmation\nCollecte enregistree;
    :Sauvegarde aussi en SQLite\n(historique offline);
  endif

else (Hors ligne)

  |SQLite local (sqflite)|
  :INSERT collectes\n(statut = PENDING_SYNC);

  |Agent Terrain (Flutter)|
  :Affiche message\n"Sauvegarde localement";
  note right : Mode offline-first\nReseau rural camerounais

  :Retour de la connectivite\n(ConnectivityPlus detecte);

  |SQLite local (sqflite)|
  :SELECT * FROM collectes\nWHERE statut = PENDING_SYNC;

  while (Collectes en attente ?) is (Oui)
    |Spring Boot API :8080|
    :POST /api/v1/collectes {collecte};

    if (Reponse ?) then (201 Created)
      |SQLite local (sqflite)|
      :UPDATE statut = CONFIRMEE;
    else (409 Doublon)
      |SQLite local (sqflite)|
      :UPDATE statut = DOUBLON;
    else (Erreur reseau)
      |SQLite local (sqflite)|
      :UPDATE retryCount += 1;
    endif
  endwhile (Non)

  |Agent Terrain (Flutter)|
  :Notification in-app\nN collecte(s) synchronisee(s);

endif

stop

@enduml
