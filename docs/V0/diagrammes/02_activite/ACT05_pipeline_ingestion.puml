@startuml ACT05_pipeline_ingestion
skinparam shadowing false
skinparam defaultFontSize 11
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam activity {
  BackgroundColor white
  BorderColor #666666
  DiamondBackgroundColor white
  DiamondBorderColor #666666
}
skinparam note {
  BackgroundColor #FFFFEE
  BorderColor #AAAAAA
}

title ACT05 - Pipeline d'Ingestion Quotidien\nVue d'ensemble Airflow 2.8.4

| Airflow Scheduler |
| Sources (MTN/Orange/CBS/Mobile) |
| PostgreSQL raw |
| dbt Core 1.8 |
| PostgreSQL dw/ml |
| Spring Boot API |

start

|Airflow Scheduler|
:Declenchement automatique\n06h00 (cron: 0 6 * * *);

fork
  |Sources (MTN/Orange/CBS/Mobile)|
  :MTN MoMo API - dag_ingestion_mtn;
fork again
  :Orange Money API - dag_ingestion_orange;
fork again
  :CBS - export quotidien - dag_ingestion_cbs;
fork again
  :App Mobile Flutter - collectes terrain;
end fork

|Airflow Scheduler|
:Detection donnees\nnon encore traitees;

|PostgreSQL raw|
:LOAD INTO raw schema\n(sources brutes horodatees);

|Airflow Scheduler|
:Calcul UUID\n(deduplication inter-appels);

|PostgreSQL raw|
:INSERT ON CONFLICT DO NOTHING;

|Airflow Scheduler|
:Validation des donnees\n(types, montants > 0, dates valides);

if (Erreurs critiques\ndetectees ?) then (Oui)
  :Rejet lignes erronees\n-> table error_log;
  :Notification email DSI;
else (Non)
endif

|dbt Core 1.8|
:dbt run --select staging.*\n(raw -> staging : nettoyage, normalisation);
:dbt run --select intermediate.*\n(staging -> int : agregats metier);
:dbt run --select mart.*\n(int -> dw : mart_kpi_collecte,\nmart_kpi_recouvrement,\nmart_benchmarks_agences);
:dbt run --select ml.*\n(ml_feat_* : feature engineering);
:dbt test\n(not_null, unique, accepted_values);

if (Tests dbt\nechecs ?) then (Oui)
  |Airflow Scheduler|
  :Alerte email DSI\n+ log erreur;
  stop
else (Non)
endif

|PostgreSQL dw/ml|
:DW mis a jour\n(mart_kpi_*, ml.features_client);

|Spring Boot API|
:Donnees disponibles\npour dashboards Angular a 08h00;
:Declenchement dag_alertes_impayes\n(calcul PAR30/90 + alertes SSE/FCM);

|Airflow Scheduler|
:Log execution terminee\n(duree, volumes, statut);

stop

@enduml
