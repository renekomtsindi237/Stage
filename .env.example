# .env.example — Variables d'environnement du pipeline IMF
# Copier ce fichier en .env et adapter les valeurs selon l'environnement.
# NE JAMAIS committer le fichier .env dans Git (.gitignore).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=imf_db
POSTGRES_USER=imf_user
POSTGRES_PASSWORD=changeme_dev
POSTGRES_SSL_MODE=disable

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=1000
AIRFLOW__CORE__FERNET_KEY=generate_with__python_-c__"from_cryptography.fernet_import_Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_dev

# ── Spring Boot Backend ───────────────────────────────────────────────────────
SPRING_BASE_URL=http://localhost:8080
SPRING_API_KEY=changeme_internal_api_key
JWT_SECRET=changeme_jwt_secret_min_32_chars_long

# ── ML / MCRS ─────────────────────────────────────────────────────────────────
MCRS_MODEL_DIR=/ml/models/mcrs
MCRS_API_URL=http://ml-api:8090
MCRS_API_TIMEOUT=60
MCRS_BATCH_SIZE=500
MCRS_PSI_THRESHOLD=0.20
MCRS_HISTORIQUE_JOURS=730
MCRS_N_FOLDS=5
MCRS_SEUIL_PROMO_AUC=0.005
MCRS_POIDS_CRS=0.35
MCRS_POIDS_RPS=0.45
MCRS_POIDS_CSI=0.20
MCRS_SEUIL_MODERE=0.30
MCRS_SEUIL_ELEVE=0.55
MCRS_SEUIL_CRITIQUE=0.75

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_PROJECT_DIR=/app/pipeline/dbt_project
DBT_PROFILES_DIR=/app/pipeline/dbt_project
DBT_TARGET=dev

# ── CBS (données recouvrement) ────────────────────────────────────────────────
CBS_DOSSIER_ENTRANT=/data/cbs/incoming
CBS_DOSSIER_ARCHIVES=/data/cbs/archives

# ── Données externes ──────────────────────────────────────────────────────────
FETCH_HTTP_TIMEOUT_SECONDS=30
# URLs des APIs externes (laisser vide pour utiliser les valeurs par défaut)
MINCOMMERCE_API_URL=
BEAC_API_URL=
INS_API_URL=

# ── Notifications Firebase Cloud Messaging (FCM) ─────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key_here

# ── Notifications SSE (push temps réel backend) ───────────────────────────────
SSE_PUSH_URL=http://backend:8080/internal/sse/push

# ── SMTP (email résumé quotidien) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@imf.cm
SMTP_PASSWORD=changeme_dev
EMAIL_FROM=noreply@imf.cm

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=dev
